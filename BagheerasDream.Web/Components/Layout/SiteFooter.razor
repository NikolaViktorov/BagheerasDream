@inject IStringLocalizer<SiteFooter> Localizer

<footer class="site-footer">

    <div class="footer-container">

        <div class="footer-main">

            <!-- Brand -->
            <div class="footer-brand">

                <a href="/" class="footer-logo">
                    Bagheera's Dream
                </a>

                <span class="footer-subtitle">
                    @Localizer["BrandSubtitle"]
                </span>

                <p>
                    @Localizer["BrandDescription"]
                </p>

            </div>


            <!-- Explore -->
            <div class="footer-column">

                <h4>@Localizer["ExploreHeading"]</h4>

                <a href="/">@Localizer["Home"]</a>
                <a href="/home/aboutus">@Localizer["AboutUs"]</a>
                <a href="/home/contact">@Localizer["Contact"]</a>

            </div>


            <!-- Our Cats -->
            <div class="footer-column">

                <h4>@Localizer["OurCatsHeading"]</h4>

                <a href="/cats/females">@Localizer["OurFemales"]</a>
                <a href="/cats/males">@Localizer["OurMales"]</a>
                <a href="/litters">@Localizer["OurLitters"]</a>

            </div>


            <!-- Contact -->
            <div class="footer-column">

                <h4>@Localizer["GetInTouchHeading"]</h4>

                <a href="/home/contact">@Localizer["ContactUs"]</a>
            </div>

        </div>


        <!-- Bottom -->
        <div class="footer-bottom">

            <span>
                © @DateTime.Now.Year BagheerasDream. @Localizer["RightsReserved"]
            </span>

            <span>
                @Localizer["FooterNote"]
            </span>

        </div>

    </div>

</footer>
