@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject NavigationManager Navigation
@inject IStringLocalizer<NavMenu> Localizer

<header class="site-header">

    <div class="navbar-container">

        <!-- Logo -->
        <a href="/" class="brand">
            <span class="brand-name">Bagheera's Dream</span>
            <span class="brand-subtitle">BRITISH SHORTHAIR</span>
        </a>

        <!-- Mobile menu toggle -->
        <input type="checkbox"
               id="nav-toggle"
               class="nav-toggle" />

        <label for="nav-toggle" class="nav-toggle-label">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <!-- Navigation -->
        <nav class="main-navigation">

            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="nav-link">
                @Localizer["Home"]
            </NavLink>

            <NavLink href="/cats/females" class="nav-link">
                @Localizer["OurFemales"]
            </NavLink>

            <NavLink href="/cats/males" class="nav-link">
                @Localizer["OurMales"]
            </NavLink>

            <NavLink href="/litters" class="nav-link">
                @Localizer["Litters"]
            </NavLink>

            <NavLink href="/home/aboutus" class="nav-link">
                @Localizer["AboutUs"]
            </NavLink>

            <NavLink href="/home/contact" class="nav-link">
                @Localizer["Contact"]
            </NavLink>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <NavLink href="/admin" class="nav-link">
                        @Localizer["AdminPanel"]
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <div class="language-selector">
                <a href="@GetLanguageUrl("en")"
                   class="language-link @(IsCurrentLanguage("en") ? "active" : "")">
                    EN
                </a>

                <span>|</span>

                <a href="@GetLanguageUrl("de")"
                   class="language-link @(IsCurrentLanguage("de") ? "active" : "")">
                    DE
                </a>

                <span>|</span>

                <a href="@GetLanguageUrl("bg")"
                   class="language-link @(IsCurrentLanguage("bg") ? "active" : "")">
                    BG
                </a>
            </div>
        </nav>

    </div>

</header>

@code {
    private string GetLanguageUrl(string culture)
    {
        var currentUrl = new Uri(Navigation.Uri).PathAndQuery;

        return $"/set-language?culture={culture}&returnUrl={Uri.EscapeDataString(currentUrl)}";
    }

    private bool IsCurrentLanguage(string culture)
    {
        return CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == culture;
    }
}