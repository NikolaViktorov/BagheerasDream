@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject IStringLocalizer<NavMenu> Localizer

<header class="site-header">

    <div class="navbar-container">

        <!-- Logo -->
        <a href="/"
           class="brand"
           @onclick="CloseMobileMenu">
            <span class="brand-name">Bagheera's Dream</span>
            <span class="brand-subtitle">BRITISH SHORTHAIR</span>
        </a>

        <!-- Mobile menu toggle -->
        <input type="checkbox"
               id="nav-toggle"
               class="nav-toggle"
               @bind="_isMenuOpen" />

        <label for="nav-toggle" class="nav-toggle-label">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <!-- Navigation -->
        <nav class="main-navigation">

            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["Home"]
            </NavLink>

            <NavLink href="/home/aboutus"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["AboutUs"]
            </NavLink>

            <NavLink href="/cats/females"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["OurFemales"]
            </NavLink>

            <NavLink href="/cats/males"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["OurMales"]
            </NavLink>

            <NavLink href="/litters"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["Litters"]
            </NavLink>

            <NavLink href="/pets"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["Pets"]
            </NavLink>

            <NavLink href="/happy-families"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["HappyFamilies"]
            </NavLink>

            <NavLink href="/home/contact"
                     class="nav-link"
                     @onclick="CloseMobileMenu">
                @Localizer["Contact"]
            </NavLink>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <NavLink href="/admin"
                             class="nav-link"
                             @onclick="CloseMobileMenu">
                        @Localizer["AdminPanel"]
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <div class="language-selector">

                <a href="#"
                   @onclick="ChangeToEnglish"
                   @onclick:preventDefault="true"
                   class="language-link @(IsCurrentLanguage("en") ? "active" : "")">
                    EN
                </a>

                <span>|</span>

                <a href="#"
                   @onclick="ChangeToGerman"
                   @onclick:preventDefault="true"
                   class="language-link @(IsCurrentLanguage("de") ? "active" : "")">
                    DE
                </a>

                <span>|</span>

                <a href="#"
                   @onclick="ChangeToBulgarian"
                   @onclick:preventDefault="true"
                   class="language-link @(IsCurrentLanguage("bg") ? "active" : "")">
                    BG
                </a>

            </div>
        </nav>

    </div>

</header>

@code {
    private bool _isMenuOpen;

    private void CloseMobileMenu()
    {
        _isMenuOpen = false;
    }

    private void ChangeToEnglish() => ChangeLanguage("en");

    private void ChangeToGerman() => ChangeLanguage("de");

    private void ChangeToBulgarian() => ChangeLanguage("bg");

    private void ChangeLanguage(string culture)
    {
        CloseMobileMenu();

        var currentUrl = new Uri(Navigation.Uri);
        var returnUrl = currentUrl.PathAndQuery;

        var targetUrl = QueryHelpers.AddQueryString(
            "/set-language",
            new Dictionary<string, string?>
            {
                ["culture"] = culture,
                ["returnUrl"] = returnUrl
            });

        Navigation.NavigateTo(targetUrl, forceLoad: true);
    }

    private bool IsCurrentLanguage(string culture)
    {
        return CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == culture;
    }
}