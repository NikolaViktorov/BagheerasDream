@using Microsoft.AspNetCore.Components.Authorization

<header class="site-header">

    <div class="navbar-container">

        <!-- Logo -->
        <a href="/" class="brand">
            <span class="brand-name">BagheerasDream</span>
            <span class="brand-subtitle">BRITISH SHORTHAIR</span>
        </a>

        <!-- Mobile menu toggle -->
        <input type="checkbox"
               id="nav-toggle"
               class="nav-toggle" />

        <label for="nav-toggle" class="nav-toggle-label">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <!-- Navigation -->
        <nav class="main-navigation">

            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="nav-link">
                Home
            </NavLink>

            <NavLink href="/cats/females" class="nav-link">
                Our Females
            </NavLink>

            <NavLink href="/cats/males" class="nav-link">
                Our Males
            </NavLink>

            <NavLink href="/litters" class="nav-link">
                Litters
            </NavLink>

            <NavLink href="/home/aboutus" class="nav-link">
                About Us
            </NavLink>

            <NavLink href="/home/contact" class="nav-link">
                Contact
            </NavLink>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <NavLink href="/admin" class="nav-link">
                        Admin
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <NavLink href="/Account/Login" class="nav-link">
                Login
            </NavLink>
        </nav>

    </div>

</header>