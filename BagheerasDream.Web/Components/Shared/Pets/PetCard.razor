<article class="pet-card">

    <div class="pet-card-image">

        @if (!string.IsNullOrWhiteSpace(ProfileImage))
        {
            <img src="@ProfileImage" alt="@Name" />
        }
        else
        {
            <div class="pet-image-placeholder">
                <span>♡</span>
                <p>Photo coming soon</p>
            </div>
        }

    </div>

    <div class="pet-card-content">

        <div class="pet-card-meta">
            <span>@Breed</span>
            <span>@Color</span>
        </div>

        <h3>@Name</h3>

        <div class="pet-card-footer">

            <span>@Age</span>

            <span class="pet-card-gender">
                @Gender
            </span>

        </div>

    </div>

</article>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public DateTime Birthday { get; set; }

    [Parameter] public string Color { get; set; } = string.Empty;

    [Parameter] public string Breed { get; set; } = string.Empty;

    [Parameter] public string Gender { get; set; } = string.Empty;

    [Parameter] public string? ProfileImage { get; set; }

    private string Age
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var birthday = Birthday;

            var years = today.Year - birthday.Year;
            var months = today.Month - birthday.Month;

            if (today.Day < birthday.Day)
                months--;

            if (months < 0)
            {
                years--;
                months += 12;
            }

            if (years == 0)
                return months == 1 ? "1 month old" : $"{months} months old";

            return years == 1 ? "1 year old" : $"{years} years old";
        }
    }
}