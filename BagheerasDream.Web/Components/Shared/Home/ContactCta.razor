@inject IStringLocalizer<ContactCta> Localizer

<section class="contact-cta">

    <div class="contact-cta-container">

        <span class="section-eyebrow">
            @Localizer["Eyebrow"]
        </span>

        <h2>
            @Localizer["Heading"]
            <span>@Localizer["HeadingHighlight"]</span>
        </h2>

        <p>
            @Localizer["Description"]
        </p>

        <a href="/home/contact" class="contact-cta-button">
            @Localizer["ContactUs"]
            <span>→</span>
        </a>

        <div class="contact-cta-decoration">
            @Localizer["Decoration"]
        </div>

    </div>

</section>
