@inject IStringLocalizer<MeetOurCats> Localizer

<section class="meet-cats-section">

    <div class="meet-cats-container">

        <!-- Section Heading -->
        <div class="meet-cats-heading">

            <span class="section-eyebrow">
                @Localizer["Eyebrow"]
            </span>

            <h2>
                @Localizer["Heading"]
                <span>@Localizer["HeadingHighlight"]</span>
            </h2>

            <p>
                @Localizer["Description"]
            </p>

        </div>


        <!-- Cat Categories -->
        <div class="cat-categories">

            <!-- Females -->
            <a href="/cats/females" class="cat-category-card">

                <div class="category-image-wrapper">

                    <img src="/images/home/females.jpg"
                         alt="@Localizer["FemalesImageAlt"]"
                         class="category-image" />

                    <div class="category-overlay"></div>

                    <div class="category-content">

                        <span class="category-number">
                            @Localizer["FemalesNumber"]
                        </span>

                        <h3>@Localizer["FemalesTitle"]</h3>

                        <span class="category-link">
                            @Localizer["DiscoverMore"]
                            <span>→</span>
                        </span>

                    </div>

                </div>

            </a>


            <!-- Males -->
            <a href="/cats/males" class="cat-category-card">

                <div class="category-image-wrapper">

                    <img src="/images/home/males.jpg"
                         alt="@Localizer["MalesImageAlt"]"
                         class="category-image" />

                    <div class="category-overlay"></div>

                    <div class="category-content">

                        <span class="category-number">
                            @Localizer["MalesNumber"]
                        </span>

                        <h3>@Localizer["MalesTitle"]</h3>

                        <span class="category-link">
                            @Localizer["DiscoverMore"]
                            <span>→</span>
                        </span>

                    </div>

                </div>

            </a>

        </div>


        <!-- Bottom Note -->
        <div class="meet-cats-footer">

            <span>@Localizer["FooterBreed"]</span>

            <span>@Localizer["FooterNote"]</span>

        </div>

    </div>

</section>