@using BagheerasDream.Application.DTOs.Litters
@using BagheerasDream.Application.Interfaces
@using System.Globalization
@inject ILittersService LittersService

<section class="latest-litters-section">

    <div class="litters-container">

        <!-- Section Header -->
        <div class="litters-header">

            <div class="litters-heading">

                <span class="section-eyebrow">
                    THE NEXT GENERATION
                </span>

                <h2>
                    Our Little <span>Ones.</span>
                </h2>

                <p>
                    Discover our litters and follow the
                    first steps of our little British Shorthairs.
                </p>

            </div>

            <a href="/litters" class="litters-view-all">
                VIEW ALL LITTERS
                <span>→</span>
            </a>

        </div>


        <!-- Litter Cards -->
        <div class="litters-grid">
            @if (IsLoading)
            {
                <p>Loading litters...</p>
            }
            else if (LittersList.Any())
            {
                @foreach (var litter in LittersList)
                {
                    <article class="litter-card">

                        <a href="@($"/litters/{litter.LitterId}")" class="litter-image-wrapper">
                            <img src="@(string.IsNullOrWhiteSpace(litter.PhotoOfLitter)
                                            ? "/images/placeholder.jpg"
                                            : litter.PhotoOfLitter)"
                                 alt="@litter.Name"
                                 class="litter-image" />
                        </a>

                        <div class="litter-card-content">

                            <div class="litter-card-top">

                                <span class="litter-label">
                                    BAGHEERASDREAM
                                </span>

                                <span class="litter-date">
                                    @litter.Birthday.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
                                </span>

                            </div>

                            <h3>@litter.Name</h3>

                            <div class="litter-card-bottom">

                                <span class="litter-count">
                                    @litter.KittenCount @(litter.KittenCount > 1 ? "Kittens" : "Kitten")
                                </span>

                                <a href="@($"/litters/{litter.LitterId}")" class="litter-details">
                                    VIEW LITTER
                                    <span>→</span>
                                </a>

                            </div>

                        </div>

                    </article>
                }
            }
            else if (ErrorMessage is not null)
            {
                <p>@ErrorMessage</p>
            }
            else
            {
                <div class="empty-litters">
                    <span>♡</span>
                    <h2>Beautiful moments are coming.</h2>
                    <p>We currently have no litters to display.</p>
                </div>
            }
        </div>


        <!-- Bottom Decoration -->
        <div class="litters-footer">

            <span>EVERY LITTLE PAW HAS A STORY</span>

            <span>RAISED WITH LOVE & CARE</span>

        </div>

    </div>

</section>


@code {
    private List<LitterListDto> LittersList = new();

    private bool IsLoading = true;

    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LittersList = (await LittersService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading litters: {ex}");
            ErrorMessage = "Unable to load litters. Please try again later.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}