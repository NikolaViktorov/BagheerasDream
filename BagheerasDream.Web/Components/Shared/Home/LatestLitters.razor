@using BagheerasDream.Application.DTOs.Litters
@using BagheerasDream.Application.Interfaces
@using System.Globalization
@inject ILittersService LittersService
@inject IStringLocalizer<LatestLitters> Localizer

<section class="latest-litters-section">

    <div class="litters-container">

        <div class="litters-header">

            <div class="litters-heading">

                <span class="section-eyebrow">
                    @Localizer["Eyebrow"]
                </span>

                <h2>
                    @Localizer["Heading"] <span>@Localizer["HeadingHighlight"]</span>
                </h2>

                <p>
                    @Localizer["Description"]
                </p>

            </div>

            <a href="/litters" class="litters-view-all">
                @Localizer["ViewAllLitters"]
                <span>→</span>
            </a>

        </div>

        <div class="litters-grid">
            @if (IsLoading)
            {
                <p>@Localizer["LoadingLitters"]</p>
            }
            else if (LittersList.Any())
            {
                @foreach (var litter in LittersList)
                {
                    <article class="litter-card">

                        <a href="@($"/litters/{litter.LitterId}")" class="litter-image-wrapper">
                            <img src="@(string.IsNullOrWhiteSpace(litter.PhotoOfLitter)
                                                                        ? "/images/placeholder.jpg"
                                                                        : litter.PhotoOfLitter)"
                                 alt="@litter.Name"
                                 class="litter-image" />
                        </a>

                        <div class="litter-card-content">

                            <div class="litter-card-top">

                                <span class="litter-label">
                                    BAGHEERASDREAM
                                </span>

                                <span class="litter-date">
                                    @litter.Birthday.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)
                                </span>

                            </div>

                            <h3>@litter.Name</h3>

                            <div class="litter-card-bottom">

                                <span class="litter-count">
                                    @litter.KittenCount @GetKittenCountLabel(litter.KittenCount)
                                </span>

                                <a href="@($"/litters/{litter.LitterId}")" class="litter-details">
                                    @Localizer["ViewLitter"]
                                    <span>→</span>
                                </a>

                            </div>

                        </div>

                    </article>
                }
            }
            else if (ErrorMessage is not null)
            {
                <p>@Localizer["LoadError"]</p>
            }
            else
            {
                <div class="empty-litters">
                    <span>♡</span>
                    <h2>@Localizer["EmptyHeading"]</h2>
                    <p>@Localizer["EmptyDescription"]</p>
                </div>
            }
        </div>

        <div class="litters-footer">

            <span>@Localizer["FooterFirst"]</span>

            <span>@Localizer["FooterSecond"]</span>

        </div>

    </div>

</section>


@code {
    private List<LitterListDto> LittersList = new();

    private bool IsLoading = true;

    private string? ErrorMessage;

    private string GetKittenCountLabel(int count)
    {
        var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

        return language switch
        {
            "bg" => count == 1 ? Localizer["KittenSingular"] : Localizer["KittenPlural"],
            "de" => count == 1 ? Localizer["KittenSingular"] : Localizer["KittenPlural"],
            _ => count == 1 ? Localizer["KittenSingular"] : Localizer["KittenPlural"]
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LittersList = (await LittersService.GetAllAsync())
                .OrderByDescending(litter => litter.Birthday)
                .Take(3)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading litters: {ex}");
            ErrorMessage = "Unable to load litters. Please try again later.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}