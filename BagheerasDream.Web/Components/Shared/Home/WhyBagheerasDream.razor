@inject IStringLocalizer<WhyBagheerasDream> Localizer

<section class="why-section">
    <div class="why-container">
        <!-- Section Introduction -->
        <div class="why-intro">
            <span class="section-eyebrow">@Localizer["Eyebrow"]</span>

            <h2>
                @Localizer["Heading"]
                <span>@Localizer["HeadingHighlight"]</span>
            </h2>

            <p>@Localizer["Description"]</p>

            <a href="/home/aboutus" class="why-story-link">
                @Localizer["StoryLink"]
                <span>→</span>
            </a>
        </div>

        <!-- Our Principles -->
        <div class="why-principles">
            <article class="why-card">
                <span class="why-number">01</span>
                <div class="why-icon">♡</div>
                <h3>@Localizer["LoveCareTitle"]</h3>
                <p>@Localizer["LoveCareDescription"]</p>
            </article>

            <article class="why-card">
                <span class="why-number">02</span>
                <div class="why-icon">✧</div>
                <h3>@Localizer["ResponsibleBreedingTitle"]</h3>
                <p>@Localizer["ResponsibleBreedingDescription"]</p>
            </article>

            <article class="why-card">
                <span class="why-number">03</span>
                <div class="why-icon">◇</div>
                <h3>@Localizer["HealthWellbeingTitle"]</h3>
                <p>@Localizer["HealthWellbeingDescription"]</p>
            </article>

            <article class="why-card">
                <span class="why-number">04</span>
                <div class="why-icon">⌂</div>
                <h3>@Localizer["LovingHomeTitle"]</h3>
                <p>@Localizer["LovingHomeDescription"]</p>
            </article>
        </div>
    </div>

    <!-- Bottom Decoration -->
    <div class="why-footer">
        <span>@Localizer["FooterPromise"]</span>
        <span>@Localizer["FooterBrand"]</span>
    </div>
</section>
