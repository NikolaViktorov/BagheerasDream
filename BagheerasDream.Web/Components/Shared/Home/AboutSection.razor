@inject IStringLocalizer<AboutSection> Localizer

<section class="about-section">

    <div class="about-container">

        <!-- Image -->
        <div class="about-visual">

            <div class="about-image-frame">
                <img src="/images/home/main2.jpg"
                     alt="@Localizer["ImageAlt"]"
                     class="about-image" />
            </div>

            <div class="about-image-decoration"></div>

            <span class="about-image-caption">
                @Localizer["ImageCaption"]
            </span>

        </div>

        <!-- Content -->
        <div class="about-content">

            <span class="about-eyebrow">
                @Localizer["Eyebrow"]
            </span>

            <h2>
                @Localizer["Heading"]
                <span>@Localizer["HeadingHighlight"]</span>
            </h2>

            <div class="about-divider"></div>

            <p class="about-description">
                @Localizer["Description"]
            </p>

            <a href="/home/aboutus" class="about-button">
                @Localizer["DiscoverStory"]
                <span>→</span>
            </a>

        </div>

    </div>

</section>