@using BagheerasDream.Application.DTOs.Litters

@inject IStringLocalizer<LitterCard> Localizer

<a href="@($"/litters/{Item.LitterId}")" class="litter-card">

    <div class="litter-image">

        @if (!string.IsNullOrWhiteSpace(Item.PhotoOfLitter))
        {
            <img src="@Item.PhotoOfLitter"
                 alt="@Item.Name" />
        }
        else
        {
            <img src="/images/placeholder.jpg"
                 alt="No Image Available" />
        }

        <span class="litter-badge">
            @Localizer["KittenCount", Item.KittenCount]
        </span>

    </div>

    <div class="litter-content">

        <span class="litter-date">
            @Localizer["Born"] @Item.Birthday.ToString("dd.MM.yyyy")
        </span>

        <h3>@Item.Name</h3>

        <div class="litter-mother">
            <span>@Localizer["Mother"]</span>
            <strong>@Item.MotherName</strong>
        </div>

        <div class="litter-card-bottom">
            <span>@Localizer["DiscoverLitter"]</span>
            <span class="litter-arrow">→</span>
        </div>

    </div>

</a>

@code {
    [Parameter, EditorRequired]
    public LitterListDto Item { get; set; } = null!;
}
