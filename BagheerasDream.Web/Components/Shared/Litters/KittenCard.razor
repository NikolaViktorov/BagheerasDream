@using BagheerasDream.Application.DTOs.Litters

@inject IStringLocalizer<KittenCard> Localizer

<article class="kitten-card">

    <div class="kitten-image"
         @onclick="OpenImage"
         style="cursor: @(HasImage ? "pointer" : "default")">

        @if (HasImage)
        {
            <img src="@Kitten.ProfileImage" alt="@Kitten.Name" />
        }
        else
        {
            <div class="kitten-placeholder">
                <span>♡</span>
            </div>
        }

        <span class="kitten-status @GetStatusClass()">
            @Localizer[Kitten.Status.ToString()]
        </span>

    </div>

    <div class="kitten-info">
        <h3>@(string.IsNullOrWhiteSpace(Kitten.Name) ? Localizer["LittleOne"].Value : Kitten.Name)</h3>

        <span class="kitten-gender">
            @Localizer[Kitten.Gender.ToString()]
        </span>
    </div>

</article>

@if (_isImageOpen && HasImage)
{
    <div class="kitten-lightbox"
         @onclick="CloseImage">

        <button class="kitten-lightbox-close"
                @onclick="CloseImage"
                aria-label="Close image">
            &times;
        </button>

        <img src="@Kitten.ProfileImage"
             alt="@Kitten.Name"
             class="kitten-lightbox-image"
             @onclick:stopPropagation="true" />

    </div>
}

@code {
    [Parameter, EditorRequired]
    public KittenListDto Kitten { get; set; } = null!;

    private bool _isImageOpen;

    private bool HasImage =>
        !string.IsNullOrWhiteSpace(Kitten.ProfileImage);

    private void OpenImage()
    {
        if (HasImage)
            _isImageOpen = true;
    }

    private void CloseImage()
    {
        _isImageOpen = false;
    }

    private string GetStatusClass()
    {
        return Kitten.Status.ToString().ToLowerInvariant();
    }
}