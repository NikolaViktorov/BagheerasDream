@using BagheerasDream.Application.DTOs.Litters

@inject IStringLocalizer<KittenCard> Localizer

<article class="kitten-card">

    <div class="kitten-image">
        @if (!string.IsNullOrWhiteSpace(Kitten.ProfileImage))
        {
            <img src="@Kitten.ProfileImage" alt="@Kitten.Name" />
        }
        else
        {
            <div class="kitten-placeholder">
                <span>♡</span>
            </div>
        }

        <span class="kitten-status @GetStatusClass()">
            @Localizer[Kitten.Status.ToString()]
        </span>
    </div>

    <div class="kitten-info">
        <h3>@(string.IsNullOrWhiteSpace(Kitten.Name) ? Localizer["LittleOne"].Value : Kitten.Name)</h3>

        <span class="kitten-gender">
            @Localizer[Kitten.Gender.ToString()]
        </span>
    </div>

</article>

@code {
    [Parameter, EditorRequired]
    public KittenListDto Kitten { get; set; } = null!;

    private string GetStatusClass()
    {
        return Kitten.Status.ToString().ToLowerInvariant();
    }
}
