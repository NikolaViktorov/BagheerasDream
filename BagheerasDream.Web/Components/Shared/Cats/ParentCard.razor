@if (!string.IsNullOrWhiteSpace(ParentName))
{
    <div class="cat-parent-card">
        <span class="cat-parent-label">@Label</span>

        @if (!string.IsNullOrWhiteSpace(DetailsUrl) && DetailsUrl != "#")
        {
            <a href="@DetailsUrl" class="cat-parent-image-link">
                <div class="cat-parent-image">
                    @if (!string.IsNullOrWhiteSpace(ProfileImage))
                    {
                        <img src="@ProfileImage" alt="@ParentName" />
                    }
                    else
                    {
                        <div class="cat-parent-placeholder">🐱</div>
                    }
                </div>
            </a>

            <a href="@DetailsUrl" class="cat-parent-name">
                <h3>@ParentName</h3>
            </a>
        }
        else
        {
            <div class="cat-parent-image">
                @if (!string.IsNullOrWhiteSpace(ProfileImage))
                {
                    <img src="@ProfileImage" alt="@ParentName" />
                }
                else
                {
                    <div class="cat-parent-placeholder">🐱</div>
                }
            </div>

            <h3>@ParentName</h3>
        }

        <p>British Shorthair</p>
    </div>
}

@code {
    [Parameter]
    public string? ParentName { get; set; }

    [Parameter]
    public string? ProfileImage { get; set; }

    [Parameter]
    public string DetailsUrl { get; set; } = "#";

    [Parameter]
    public string Label { get; set; } = "Parent";
}