@inject IStringLocalizer<CatCard> Localizer

<article class="cat-card">

    <a href="@DetailsUrl" class="cat-card-image">

        @if (!string.IsNullOrWhiteSpace(ProfileImage))
        {
            <img src="@ProfileImage" alt="@Name" />
        }
        else
        {
            <div class="cat-image-placeholder">
                <span>♡</span>
                <p>@Localizer["PhotoComingSoon"]</p>
            </div>
        }

        <div class="cat-card-overlay">
            @Localizer["ViewProfile"] →
        </div>

    </a>

    <div class="cat-card-content">

        <div class="cat-card-meta">
            <span>@Breed</span>
            <span>@Color</span>
        </div>

        <h3>@Name</h3>

        <div class="cat-card-footer">

            <span>@Age</span>

            <a href="@DetailsUrl">
                @Localizer["ViewDetails"] →
            </a>

        </div>

    </div>

</article>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public DateTime Birthday { get; set; }

    [Parameter] public string Color { get; set; } = string.Empty;

    [Parameter] public string Breed { get; set; } = string.Empty;

    [Parameter] public string? ProfileImage { get; set; }

    [Parameter] public string DetailsUrl { get; set; } = "#";

    private string Age
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var birthday = Birthday;

            var years = today.Year - birthday.Year;
            var months = today.Month - birthday.Month;

            if (today.Day < birthday.Day)
                months--;

            if (months < 0)
            {
                years--;
                months += 12;
            }

            if (years == 0)
            {
                return months == 1
                    ? Localizer["AgeMonthsOne"].Value
                    : Localizer["AgeMonthsMany", months].Value;
            }

            return years == 1
                ? Localizer["AgeYearsOne"].Value
                : Localizer["AgeYearsMany", years].Value;
        }
    }
}
