@page "/home/aboutus"

<PageTitle>About Us | Bagheera's Dream</PageTitle>

<section class="about-page">

    <!-- HERO -->

    <header class="about-hero">

        <span class="section-eyebrow">
            THE STORY BEHIND BAGHEERA'S DREAM
        </span>

        <h1>A Love for <span>British Shorthairs.</span></h1>

        <p>
            More than a cattery. A passion built around beautiful cats,
            wonderful personalities and the love they bring into our lives.
        </p>

    </header>


    <!-- OUR STORY -->

    <section class="about-story">

        <div class="about-story-visual">
            <div class="about-story-frame">
                <img src="/images/home/2.png"
                     alt="Our British Shorthair cats"
                     class="about-story-photo" />
            </div>

            <div class="about-story-caption">
                <span>01 — OUR STORY</span>
                <span>BAGHEERA'S DREAM</span>
            </div>

            <div class="about-story-decoration"></div>
        </div>

        <div class="about-story-content">

            <span class="section-eyebrow">
                GET TO KNOW US
            </span>

            <h2>Every Great Story Begins <span>With Love.</span></h2>

            <p> 
                Bagheera's Dream was created from a genuine love
                for cats and a special appreciation for the
                British Shorthair breed.
            </p>

            <p>
                We believe that every cat has its own personality,
                character and charm. Our goal is to celebrate
                everything that makes these wonderful companions
                so special.
            </p>

            <p>
                For us, breeding is not simply about appearance.
                It is about care, responsibility and giving
                every little one the best possible start in life.
            </p>

        </div>

    </section>


    <!-- OUR PHILOSOPHY -->

    <section class="about-philosophy">

        <div class="philosophy-header">

            <span class="section-eyebrow">
                WHAT MATTERS TO US
            </span>

            <h2>Our <span>Philosophy.</span></h2>

            <p>
                The values that guide everything we do.
            </p>

        </div>


        <div class="philosophy-grid">

            <article class="philosophy-card">

                <span class="philosophy-icon">♡</span>

                <h3>Love & Care</h3>

                <p>
                    Every cat deserves affection, attention
                    and a caring environment.
                </p>

            </article>


            <article class="philosophy-card">

                <span class="philosophy-icon">✧</span>

                <h3>Health & Wellbeing</h3>

                <p>
                    The health and wellbeing of our cats
                    always come first.
                </p>

            </article>


            <article class="philosophy-card">

                <span class="philosophy-icon">❋</span>

                <h3>Responsible Breeding</h3>

                <p>
                    We believe in thoughtful decisions
                    and responsible breeding practices.
                </p>

            </article>


            <article class="philosophy-card">

                <span class="philosophy-icon">♡</span>

                <h3>Happy Families</h3>

                <p>
                    Our wish is for every kitten to find
                    a loving and caring forever home.
                </p>

            </article>

        </div>

    </section>


    <!-- OUR BREED -->

    <section class="about-breed">

        <div class="about-breed-content">

            <span class="section-eyebrow">
                A VERY SPECIAL BREED
            </span>

            <h2>The Beautiful <span>British Shorthair.</span></h2>

            <p>
                Known for their round faces, plush coats
                and charming personalities, British Shorthairs
                have a special place in the hearts of cat lovers.
            </p>

            <p>
                Their distinctive appearance and gentle character
                make them truly wonderful companions.
            </p>

            <a href="/cats/females" class="about-breed-link">
                MEET OUR CATS →
            </a>

        </div>

        <div class="about-story-visual">
            <div class="about-story-frame">
                <img src="/images/home/3.jpg"
                     alt="Our British Shorthair cats"
                     class="about-story-photo" />
            </div>

            <div class="about-story-caption">
                <span>02 — BRITISH SHORTHAIR</span>
                <span>BAGHEERA'S DREAM</span>
            </div>

            <div class="about-story-decoration"></div>
        </div>

    </section>


    <!-- CLOSING CTA -->

    <section class="about-cta">

        <span class="section-eyebrow">
            WELCOME TO OUR WORLD
        </span>

        <h2>Discover the World of <span>Bagheera's Dream.</span></h2>

        <p>
            We invite you to meet our beautiful cats
            and discover the little ones who make our family special.
        </p>

        <a href="/litters" class="about-cta-button">
            DISCOVER OUR LITTERS
        </a>

    </section>

</section>