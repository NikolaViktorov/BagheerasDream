@page "/home/aboutus"
@inject IStringLocalizer<AboutUs> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer["MetaDescription"]" />
    <link rel="canonical" href="https://bagheerasdream.de/home/aboutus" />

    <meta property="og:title" content="@Localizer["OgTitle"]" />
    <meta property="og:description" content="@Localizer["OgDescription"]" />
    <meta property="og:url" content="https://bagheerasdream.de/home/aboutus" />
    <meta property="og:image" content="https://bagheerasdream.de/images/home/2.png" />
    <meta property="og:type" content="website" />
</HeadContent>

<section class="about-page">

    <!-- HERO -->
    <header class="about-hero">
        <span class="section-eyebrow">
            @Localizer["HeroEyebrow"]
        </span>

        <h1>
            @Localizer["HeroHeading"]
            <span>@Localizer["HeroHeadingHighlight"]</span>
        </h1>

        <p>
            @Localizer["HeroDescription"]
        </p>
    </header>


    <!-- OUR STORY -->
    <section class="about-story">
        <div class="about-story-visual">
            <div class="about-story-frame">
                <img src="/images/home/aboutus1.png"
                     alt="@Localizer["StoryImageAlt"]"
                     class="about-story-photo" />
            </div>

            <div class="about-story-caption">
                <span>@Localizer["StoryCaptionNumber"]</span>
                <span>BAGHEERA'S DREAM</span>
            </div>

            <div class="about-story-decoration"></div>
        </div>

        <div class="about-story-content">
            <span class="section-eyebrow">
                @Localizer["StoryEyebrow"]
            </span>

            <h2>
                @Localizer["StoryHeading"]
                <span>@Localizer["StoryHeadingHighlight"]</span>
            </h2>

            <p>
                @Localizer["StoryDescription"]
            </p>
        </div>
    </section>


    <!-- OUR PHILOSOPHY -->
    <section class="about-philosophy">
        <div class="philosophy-header">
            <span class="section-eyebrow">
                @Localizer["PhilosophyEyebrow"]
            </span>

            <h2>
                @Localizer["PhilosophyHeading"]
                <span>@Localizer["PhilosophyHeadingHighlight"]</span>
            </h2>

            <p>
                @Localizer["PhilosophyDescription"]
            </p>
        </div>

        <div class="philosophy-grid">
            <article class="philosophy-card">
                <span class="philosophy-icon">♡</span>
                <h3>@Localizer["LoveCareTitle"]</h3>
                <p>@Localizer["LoveCareDescription"]</p>
            </article>

            <article class="philosophy-card">
                <span class="philosophy-icon">✧</span>
                <h3>@Localizer["HealthWellbeingTitle"]</h3>
                <p>@Localizer["HealthWellbeingDescription"]</p>
            </article>

            <article class="philosophy-card">
                <span class="philosophy-icon">❋</span>
                <h3>@Localizer["ResponsibleBreedingTitle"]</h3>
                <p>@Localizer["ResponsibleBreedingDescription"]</p>
            </article>

            <article class="philosophy-card">
                <span class="philosophy-icon">♡</span>
                <h3>@Localizer["HappyFamiliesTitle"]</h3>
                <p>@Localizer["HappyFamiliesDescription"]</p>

                <a href="/happy-families" class="philosophy-link">
                    @Localizer["HappyFamiliesLink"] →
                </a>
            </article>
        </div>
    </section>


    <!-- OUR BREED -->
    <section class="about-breed">
        <div class="about-breed-content">
            <span class="section-eyebrow">
                @Localizer["BreedEyebrow"]
            </span>

            <h2>
                @Localizer["BreedHeading"]
                <span>@Localizer["BreedHeadingHighlight"]</span>
            </h2>

            <p>
                @Localizer["BreedDescription"]
            </p>
        </div>

        <div class="about-story-visual">
            <div class="about-story-frame">
                <img src="/images/home/aboutus2.jpg"
                     alt="@Localizer["BreedImageAlt"]"
                     class="about-story-photo" />
            </div>

            <div class="about-story-caption">
                <span>@Localizer["BreedImageCaption"]</span>
                <span>@Localizer["BreedImageDay"]</span>
            </div>

            <div class="about-story-decoration"></div>
        </div>
    </section>


    <!-- CLOSING CTA -->
    <section class="about-cta">
        <span class="section-eyebrow">
            @Localizer["CtaEyebrow"]
        </span>

        <h2>
            @Localizer["CtaHeading"]
            <span>@Localizer["CtaHeadingHighlight"]</span>
        </h2>

        <p>
            @Localizer["CtaDescription"]
        </p>

        <a href="/litters" class="about-cta-button">
            @Localizer["CtaButton"]
        </a>
    </section>

</section>
