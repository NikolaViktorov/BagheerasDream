@page "/pets"

@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Web.Extensions
@using BagheerasDream.Application.DTOs.Pets
@using BagheerasDream.Web.Components.Shared.Pets

@inject IPetsService PetsService
@inject IStringLocalizer<Pets> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer["MetaDescription"]" />
    <link rel="canonical" href="https://bagheerasdream.de/pets" />
    <meta property="og:title" content="@Localizer["OgTitle"]" />
    <meta property="og:description" content="@Localizer["OgDescription"]" />
    <meta property="og:url" content="https://bagheerasdream.de/pets" />
    <meta property="og:image" content="https://bagheerasdream.de/images/home/5.jpg" />
    <meta property="og:type" content="website" />
</HeadContent>

<section class="pets-page">

    <div class="pets-header">
        <span class="section-eyebrow">@Localizer["HeaderEyebrow"]</span>

        <h1>
            @Localizer["Heading"] <span>@Localizer["HeadingHighlight"]</span>
        </h1>

        <p>
            @Localizer["Description"]
        </p>
    </div>

    <div class="pets-container">

        @if (IsLoading)
        {
            <div class="empty-pets">
                <p>@Localizer["Loading"]</p>
            </div>
        }
        else if (PetsList.Any())
        {
            <div class="pets-grid">
                @foreach (var pet in PetsList)
                {
                    <PetCard Name="@pet.Name"
                             Birthday="@pet.Birthday.ToDateTime(TimeOnly.MinValue)"
                             Color="@pet.Color.ToDisplayName()"
                             Breed="@pet.Breed.ToDisplayName()"
                             Gender="@pet.Gender.ToString()"
                             ProfileImage="@pet.ProfileImage" />
                }
            </div>
        }
        else
        {
            <div class="empty-pets">
                <h3>@Localizer["EmptyHeading"]</h3>
                <p>@Localizer["EmptyDescription"]</p>
            </div>
        }

    </div>

    <div class="pets-bottom">
        <span>@Localizer["FooterBreed"]</span>
        <span>@Localizer["FooterNote"]</span>
    </div>

</section>

@code {
    private List<PetListDto> PetsList = new();
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PetsList = (await PetsService.GetAllAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}
