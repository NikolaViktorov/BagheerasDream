@page "/home/contact"
@using System.ComponentModel.DataAnnotations

<PageTitle>Contact Us | BagheerasDream</PageTitle>

<section class="contact-page">

    <!-- HERO -->

    <header class="contact-hero">

        <span class="section-eyebrow">
            WE WOULD LOVE TO HEAR FROM YOU
        </span>

        <h1>Let's Start a <span>Conversation.</span></h1>

        <p>
            Whether you are interested in our cats, have a question
            or simply want to learn more about us, we would be happy
            to hear from you.
        </p>

    </header>


    <!-- CONTACT CONTENT -->

    <section class="contact-content">

        <div class="contact-info">

            <span class="section-eyebrow">
                GET IN TOUCH
            </span>

            <h2>We Are Here <span>For You.</span></h2>

            <p>
                Finding the right kitten is a special journey.
                We believe that every future family deserves
                time, attention and honest communication.
            </p>

            <div class="contact-info-item">
                <span class="contact-icon">♡</span>

                <div>
                    <h3>Kitten Enquiries</h3>
                    <p>
                        Interested in one of our kittens?
                        Feel free to send us a message.
                    </p>
                </div>
            </div>

            <div class="contact-info-item">
                <span class="contact-icon">✧</span>

                <div>
                    <h3>General Questions</h3>
                    <p>
                        Have questions about our cattery
                        or the British Shorthair breed?
                        We are happy to help.
                    </p>
                </div>
            </div>

            <div class="contact-note">
                Every message matters to us. We look forward
                to getting to know you.
            </div>

        </div>


        <!-- CONTACT FORM -->

        <div class="contact-form-container">

            <div class="form-heading">
                <h2>Send Us a Message</h2>
                <p>Fill in the form below and tell us how we can help.</p>
            </div>

            @if (submitted)
            {
                <div class="form-success">
                    <span>♡</span>
                    <h3>Thank You!</h3>
                    <p>
                        Your message has been prepared successfully.
                        Actual message delivery will be enabled soon.
                    </p>

                    <button type="button" @onclick="ResetForm">
                        SEND ANOTHER MESSAGE
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="@contactModel" OnValidSubmit="HandleSubmit">

                    <DataAnnotationsValidator />

                    <div class="form-row">

                        <div class="form-group">
                            <label for="name">Your Name *</label>

                            <InputText id="name"
                                       @bind-Value="contactModel.Name"
                                       placeholder="Your full name" />

                            <ValidationMessage For="@(() => contactModel.Name)" />
                        </div>

                        <div class="form-group">
                            <label for="email">Email Address *</label>

                            <InputText id="email"
                                       type="email"
                                       @bind-Value="contactModel.Email"
                                       placeholder="your@email.com" />

                            <ValidationMessage For="@(() => contactModel.Email)" />
                        </div>

                    </div>


                    <div class="form-group">
                        <label for="subject">What is your enquiry about? *</label>

                        <InputSelect id="subject"
                                     @bind-Value="contactModel.Subject">

                            <option value="">Select an option</option>
                            <option value="Kitten Enquiry">Kitten Enquiry</option>
                            <option value="Available Kittens">Available Kittens</option>
                            <option value="Our Cattery">Our Cattery</option>
                            <option value="General Question">General Question</option>
                            <option value="Other">Other</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => contactModel.Subject)" />
                    </div>


                    <div class="form-group">
                        <label for="message">Your Message *</label>

                        <InputTextArea id="message"
                                       @bind-Value="contactModel.Message"
                                       placeholder="Tell us a little about your enquiry..."
                                       rows="6" />

                        <ValidationMessage For="@(() => contactModel.Message)" />
                    </div>


                    <button type="submit" class="contact-submit">
                        SEND MESSAGE <span>→</span>
                    </button>

                    <p class="form-disclaimer">
                        * Required fields
                    </p>

                </EditForm>
            }

        </div>

    </section>


    <!-- BOTTOM CTA -->

    <section class="contact-bottom">

        <span class="section-eyebrow">
            A LITTLE WORLD OF LOVE
        </span>

        <h2>Perhaps Your New Best Friend <span>Is Waiting.</span></h2>

        <p>
            Discover our beautiful British Shorthairs
            and meet the little ones looking for their forever homes.
        </p>

        <a href="/litters" class="contact-bottom-button">
            EXPLORE OUR LITTERS
        </a>

    </section>

</section>


@code {

    private ContactFormModel contactModel = new();

    private bool submitted = false;

    private void HandleSubmit()
    {
        submitted = true;
    }

    private void ResetForm()
    {
        contactModel = new ContactFormModel();
        submitted = false;
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Please enter your name.")]
        [MaxLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please select an enquiry type.")]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter your message.")]
        [MinLength(10, ErrorMessage = "Your message must contain at least 10 characters.")]
        [MaxLength(2000)]
        public string Message { get; set; } = string.Empty;
    }

}