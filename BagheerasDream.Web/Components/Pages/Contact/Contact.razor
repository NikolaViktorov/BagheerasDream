@page "/home/contact"

<PageTitle>Contact Us | BagheerasDream</PageTitle>

<section class="contact-page">

    <!-- HERO -->

    <header class="contact-hero">

        <span class="section-eyebrow">
            WE WOULD LOVE TO HEAR FROM YOU
        </span>

        <h1>Let's Start a <span>Conversation.</span></h1>

        <p>
            Whether you are interested in our cats, have a question
            or simply want to learn more about us, we would be happy
            to hear from you.
        </p>

    </header>


    <!-- CONTACT CONTENT -->

    <section class="contact-content">

        <!-- CONTACT INFORMATION -->

        <div class="contact-info">

            <span class="section-eyebrow">
                GET IN TOUCH
            </span>

            <h2>We Are Here <span>For You.</span></h2>

            <p>
                Finding the right kitten is a special journey.
                We believe that every future family deserves
                time, attention and honest communication.
            </p>

            <div class="contact-info-item">
                <span class="contact-icon">♡</span>

                <div>
                    <h3>Kitten Enquiries</h3>
                    <p>
                        Interested in one of our kittens?
                        Feel free to get in touch with us.
                    </p>
                </div>
            </div>

            <div class="contact-info-item">
                <span class="contact-icon">✧</span>

                <div>
                    <h3>General Questions</h3>
                    <p>
                        Have questions about our cattery
                        or the British Shorthair breed?
                        We are always happy to help.
                    </p>
                </div>
            </div>

            <div class="contact-note">
                Every message matters to us. We look forward
                to getting to know you.
            </div>

        </div>


        <!-- CONTACT METHODS -->

        <div class="contact-methods">

            <div class="form-heading">
                <h2>Connect With Us</h2>
                <p>
                    Choose your preferred way to get in touch with us.
                    We would love to hear from you!
                </p>
            </div>


            <!-- PHONE -->

            <div class="contact-method-card">

                <div class="contact-method-icon">☎</div>

                <div class="contact-method-info">
                    <h3>Phone</h3>
                    <p>
                        Give us a call. We will be happy to hear from you.
                    </p>
                    <span>+49 1525 9005871</span>
                </div>

                <a href="tel:+4915259005871"
                   class="contact-method-button">
                    CALL US →
                </a>

            </div>


            <!-- WHATSAPP -->

            <div class="contact-method-card">

                <div class="contact-method-icon">♡</div>

                <div class="contact-method-info">
                    <h3>WhatsApp</h3>
                    <p>
                        Have a question? Send us a message directly.
                    </p>
                    <span>Chat with us on WhatsApp</span>
                </div>

                <a href="https://wa.me/4915259005871"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-method-button">
                    MESSAGE US →
                </a>

            </div>


            <!-- INSTAGRAM -->

            <div class="contact-method-card">

                <div class="contact-method-icon">◎</div>

                <div class="contact-method-info">
                    <h3>Instagram</h3>
                    <p>
                        Follow our cattery and send us a direct message.
                    </p>
                    <span>@@bagheeras.dream.cattery</span>
                </div>

                <a href="https://www.instagram.com/bagheeras.dream.cattery/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-method-button">
                    VISIT PROFILE →
                </a>

            </div>


            <!-- TIKTOK -->

            <div class="contact-method-card">

                <div class="contact-method-icon">♪</div>

                <div class="contact-method-info">
                    <h3>TikTok</h3>
                    <p>
                        Discover our cats and follow their little adventures.
                    </p>
                    <span>@@bagheeras.dream.de</span>
                </div>

                <a href="https://www.tiktok.com/@@bagheeras.dream.de"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-method-button">
                    VISIT PROFILE →
                </a>

            </div>

        </div>

    </section>


    <!-- BOTTOM CTA -->

    <section class="contact-bottom">

        <span class="section-eyebrow">
            A LITTLE WORLD OF LOVE
        </span>

        <h2>Perhaps Your New Best Friend <span>Is Waiting.</span></h2>

        <p>
            Discover our beautiful British Shorthairs
            and meet the little ones looking for their forever homes.
        </p>

        <a href="/litters" class="contact-bottom-button">
            EXPLORE OUR LITTERS
        </a>

    </section>

</section>
