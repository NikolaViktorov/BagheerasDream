@page "/home/contact"
@inject IStringLocalizer<Contact> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer["MetaDescription"]" />
    <link rel="canonical" href="https://bagheerasdream.de/home/contact" />

    <meta property="og:title" content="@Localizer["OgTitle"]" />
    <meta property="og:description" content="@Localizer["OgDescription"]" />
    <meta property="og:url" content="https://bagheerasdream.de/home/contact" />
    <meta property="og:image" content="https://bagheerasdream.de/images/home/5.jpg" />
    <meta property="og:type" content="website" />
</HeadContent>

<section class="contact-page">

    <!-- HERO -->
    <header class="contact-hero">
        <span class="section-eyebrow">
            @Localizer["HeroEyebrow"]
        </span>

        <h1>
            @Localizer["HeroHeading"]
            <span>@Localizer["HeroHeadingHighlight"]</span>
        </h1>

        <p>
            @Localizer["HeroDescription"]
        </p>
    </header>


    <!-- CONTACT CONTENT -->
    <section class="contact-content">

        <!-- CONTACT INFORMATION -->
        <div class="contact-info">
            <span class="section-eyebrow">
                @Localizer["InfoEyebrow"]
            </span>

            <h2>
                @Localizer["InfoHeading"]
                <span>@Localizer["InfoHeadingHighlight"]</span>
            </h2>

            <p>
                @Localizer["InfoDescription"]
            </p>

            <div class="contact-info-item">
                <span class="contact-icon">♡</span>
                <div>
                    <h3>@Localizer["KittenEnquiriesTitle"]</h3>
                    <p>@Localizer["KittenEnquiriesDescription"]</p>
                </div>
            </div>

            <div class="contact-info-item">
                <span class="contact-icon">✧</span>
                <div>
                    <h3>@Localizer["GeneralQuestionsTitle"]</h3>
                    <p>@Localizer["GeneralQuestionsDescription"]</p>
                </div>
            </div>

            <div class="contact-note">
                @Localizer["ContactNote"]
            </div>
        </div>


        <!-- CONTACT METHODS -->
        <div class="contact-methods">
            <div class="form-heading">
                <h2>@Localizer["MethodsHeading"]</h2>
                <p>@Localizer["MethodsDescription"]</p>
            </div>


            <!-- PHONE -->
            <div class="contact-method-card">
                <div class="contact-method-icon">☎</div>
                <div class="contact-method-info">
                    <h3>@Localizer["PhoneTitle"]</h3>
                    <p>@Localizer["PhoneDescription"]</p>
                    <span>+49 1525 9005871</span>
                </div>
                <a href="tel:+4915259005871" class="contact-method-button">
                    @Localizer["CallUs"] →
                </a>
            </div>


            <!-- WHATSAPP -->
            <div class="contact-method-card">
                <div class="contact-method-icon">♡</div>
                <div class="contact-method-info">
                    <h3>WhatsApp</h3>
                    <p>@Localizer["WhatsAppDescription"]</p>
                    <span>@Localizer["WhatsAppLabel"]</span>
                </div>
                <a href="https://wa.me/4915259005871"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-method-button">
                    @Localizer["MessageUs"] →
                </a>
            </div>


            <!-- INSTAGRAM -->
            <div class="contact-method-card">
                <div class="contact-method-icon">◎</div>
                <div class="contact-method-info">
                    <h3>Instagram</h3>
                    <p>@Localizer["InstagramDescription"]</p>
                    <span>@@bagheeras.dream.cattery</span>
                </div>
                <a href="https://www.instagram.com/bagheeras.dream.cattery/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-method-button">
                    @Localizer["VisitProfile"] →
                </a>
            </div>


            <!-- TIKTOK -->
            <div class="contact-method-card">
                <div class="contact-method-icon">♪</div>
                <div class="contact-method-info">
                    <h3>TikTok</h3>
                    <p>@Localizer["TikTokDescription"]</p>
                    <span>@@bagheeras.dream.de</span>
                </div>
                <a href="https://www.tiktok.com/@@bagheeras.dream.de"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="contact-method-button">
                    @Localizer["VisitProfile"] →
                </a>
            </div>
        </div>
    </section>


    <!-- BOTTOM CTA -->
    <section class="contact-bottom">
        <span class="section-eyebrow">
            @Localizer["BottomEyebrow"]
        </span>

        <h2>
            @Localizer["BottomHeading"]
            <span>@Localizer["BottomHeadingHighlight"]</span>
        </h2>

        <p>
            @Localizer["BottomDescription"]
        </p>

        <a href="/litters" class="contact-bottom-button">
            @Localizer["BottomButton"]
        </a>
    </section>

</section>
