@page "/cats/{Id:guid}"

@using BagheerasDream.Domain.Enums
@using BagheerasDream.Web.Extensions
@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.DTOs.Cats

@inject ICatsService CatsService

<PageTitle>@(Cat?.Name ?? "Cat Details") | BagheerasDream</PageTitle>

@if (IsLoading)
{
    <div class="cat-not-found">
        <h1>Loading cat details...</h1>
    </div>
}
else if (ErrorMessage is not null)
{
    <div class="cat-not-found">
        <h1>@ErrorMessage</h1>
        <a href="@GetCatsUrl()">BACK TO OUR CATS →</a>
    </div>
}
else if (Cat is null)
{
    <div class="cat-not-found">
        <h1>Cat not found.</h1>
        <a href="@GetCatsUrl()">BACK TO OUR CATS →</a>
    </div>
}
else
{
    <section class="cat-details-page">

        <div class="details-breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="@GetCatsUrl()">
                @(Cat.Gender == Gender.Male ? "Our Males" : "Our Females")
            </a>
            <span>/</span>
            <span>@Cat.Name</span>
        </div>

        <div class="details-layout">

            <div class="details-image">

                @if (!string.IsNullOrWhiteSpace(Cat.ProfileImage))
                {
                    <img src="@Cat.ProfileImage" alt="@Cat.Name" />
                }
                else
                {
                    <div class="details-image-placeholder">
                        <span>♡</span>
                        <p>PHOTO COMING SOON</p>
                    </div>
                }

                <div class="image-caption">
                    <span>BRITISH SHORTHAIR</span>
                    <span>@Cat.Color.ToDisplayName()</span>
                </div>

            </div>


            <div class="details-information">

                <span class="details-eyebrow">
                    @(Cat.Gender == Gender.Female ? "MEET OUR LADY" : "MEET OUR GENTLEMAN")
                </span>

                <h1>@Cat.Name<span>.</span></h1>

                <p class="details-description">
                    @Cat.Description
                </p>

                <div class="details-facts">

                    <div>
                        <span>BREED</span>
                        <strong>@Cat.Breed.ToDisplayName()</strong>
                    </div>

                    <div>
                        <span>COLOR</span>
                        <strong>@Cat.Color.ToDisplayName()</strong>
                    </div>

                    <div>
                        <span>BIRTHDAY</span>
                        <strong>@Cat.Birthday.ToString("dd.MM.yyyy")</strong>
                    </div>

                    <div>
                        <span>AGE</span>
                        <strong>@GetCatAge(Cat.Birthday)</strong>
                    </div>

                    <div>
                        <span>GENDER</span>
                        <strong>@Cat.Gender</strong>
                    </div>

                </div>
            </div>
        </div>

        <!-- PEDIGREE -->

        @if (!string.IsNullOrEmpty(Cat.PedigreeImage))
        {
            <section class="pedigree-section">
                <div class="pedigree-header">
                    <span class="details-eyebrow">FAMILY HERITAGE</span>
                    <h2>@Cat.Name's <span>Pedigree.</span></h2>
                    <p>Discover the family history and lineage behind @Cat.Name.</p>
                </div>

                <div class="pedigree-image-container"
                     @onclick="OpenPedigreeLightbox">

                    <img src="@Cat.PedigreeImage"
                         alt="@Cat.Name's pedigree" />
                </div>

                @if (IsPedigreeLightboxOpen)
                {
                    <div class="lightbox-overlay"
                         @onclick="ClosePedigreeLightbox">

                        <button class="lightbox-close"
                                @onclick:stopPropagation="true"
                                @onclick="ClosePedigreeLightbox">
                            &times;
                        </button>

                        <img class="lightbox-image"
                             src="@Cat.PedigreeImage"
                             alt="@Cat.Name's pedigree"
                             @onclick:stopPropagation="true" />
                    </div>
                }
            </section>
        }

        <!-- GALLERY -->


        @if (Cat.GalleryImages.Any())
        {
            <section class="cat-gallery-section">

                <div class="cat-gallery-header">
                    <span class="details-eyebrow">PHOTO COLLECTION</span>

                    <h2>A Little More of <span>@Cat.Name.</span></h2>

                    <p>
                        Discover more beautiful moments from @Cat.Name's life.
                    </p>
                </div>

                <div class="cat-gallery">
                    @foreach (var image in Cat.GalleryImages)
                    {
                        <div class="cat-gallery-item"
                             @onclick="() => OpenLightbox(image.CatImageId)">
                            <img src="@image.ImagePath" alt="@Cat.Name" />
                        </div>
                    }
                </div>

                @if (IsLightboxOpen)
                {
                    <div class="lightbox-overlay" @onclick="CloseLightbox">

                        <button class="lightbox-close"
                                @onclick:preventDefault="true"
                                @onclick:stopPropagation="true"
                                @onclick="CloseLightbox">
                            &times;
                        </button>

                        <button class="lightbox-arrow lightbox-prev"
                                @onclick:stopPropagation="true"
                                @onclick="PreviousImage">
                            &#10094;
                        </button>

                        <img class="lightbox-image"
                             src="@SelectedGalleryImage?.ImagePath"
                             alt="@Cat.Name"
                             @onclick:stopPropagation="true" />

                        <button class="lightbox-arrow lightbox-next"
                                @onclick:stopPropagation="true"
                                @onclick="NextImage">
                            &#10095;
                        </button>

                        <div class="lightbox-counter">
                            @(SelectedImageIndex + 1) / @Cat.GalleryImages.Count
                        </div>

                    </div>
                }


            </section>
        }

        <!-- PARENTS -->

        <section class="parents-section">

            <div class="parents-header">

                <span class="details-eyebrow">
                    @(Cat.Gender == Gender.Male ? "His" : "Her") FAMILY TREE
                </span>

                <h2>Meet @(Cat.Gender == Gender.Male ? "His" : "Her") <span>Parents.</span></h2>

                <p>
                    Every beautiful cat has a story.
                    Discover where @Cat.Name comes from.
                </p>

            </div>


            @if (Cat.FatherId.HasValue || Cat.MotherId.HasValue)
            {
                <div class="parents-grid">

                    <ParentCard
                        ParentName="@Cat.FatherName"
                        ProfileImage="@Cat.FatherProfileImage"
                        DetailsUrl="@(Cat.FatherId.HasValue ? $"/cats/{Cat.FatherId}" : "#")"
                        Label="Father" />

                    <ParentCard
                        ParentName="@Cat.MotherName"
                        ProfileImage="@Cat.MotherProfileImage"
                        DetailsUrl="@(Cat.MotherId.HasValue ? $"/cats/{Cat.MotherId}" : "#")"
                        Label="Mother" />

                </div>
            }
            else
            {
                <div class="parents-empty">
                    <span>FAMILY HISTORY</span>
                    <h3>No family records yet.</h3>
                    <p>
                        We're still adding our cats' family history.
                        Check back soon to discover their origins.
                    </p>
                </div>
            }

        </section>

        <div class="details-bottom">
            <a href="@GetCatsUrl()">← BACK TO OUR CATS</a>
            <span>RAISED WITH LOVE & CARE</span>
        </div>

    </section>
}


@code {

    [Parameter]
    public Guid Id { get; set; }

    private CatDetailsDto? Cat { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }


    private bool IsLightboxOpen { get; set; }

    private int SelectedImageIndex { get; set; }

    private CatGalleryImageDto? SelectedGalleryImage =>
        Cat?.GalleryImages.ElementAtOrDefault(SelectedImageIndex);

    private bool IsPedigreeLightboxOpen { get; set; }

    private void OpenPedigreeLightbox()
    {
        IsPedigreeLightboxOpen = true;
    }

    private void ClosePedigreeLightbox()
    {
        IsPedigreeLightboxOpen = false;
    }

    private void OpenLightbox(Guid imageId)
    {
        if (Cat is null)
            return;

        SelectedImageIndex = Cat.GalleryImages
            .ToList()
            .FindIndex(image => image.CatImageId == imageId);

        if (SelectedImageIndex >= 0)
            IsLightboxOpen = true;
    }

    private void CloseLightbox()
    {
        IsLightboxOpen = false;
    }

    private void PreviousImage()
    {
        if (Cat is null || Cat.GalleryImages.Count == 0)
            return;

        SelectedImageIndex =
            (SelectedImageIndex - 1 + Cat.GalleryImages.Count)
            % Cat.GalleryImages.Count;
    }

    private void NextImage()
    {
        if (Cat is null || Cat.GalleryImages.Count == 0)
            return;

        SelectedImageIndex =
            (SelectedImageIndex + 1) % Cat.GalleryImages.Count;
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        Cat = null;

        try
        {
            Cat = await CatsService.GetByIdAsync(Id);
        }
        catch (Exception)
        {
            ErrorMessage = "Something went wrong while loading the cat.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static string GetCatAge(DateOnly birthday)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        var years = today.Year - birthday.Year;
        var months = today.Month - birthday.Month;

        if (today.Day < birthday.Day)
        {
            months--;
        }

        if (months < 0)
        {
            years--;
            months += 12;
        }
        
        if (years == 0)
            return months == 1 ? "1 month old" : $"{months} months old";

        return years == 1 ? "1 year old" : $"{years} years old";
    }

    private string GetCatsUrl()
    {
        return Cat?.Gender == Gender.Male
            ? "/cats/males"
            : "/cats/females";
    }
}