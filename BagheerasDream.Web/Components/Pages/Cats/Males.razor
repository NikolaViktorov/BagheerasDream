@page "/cats/males"

@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Web.Extensions
@using BagheerasDream.Application.DTOs.Cats

@inject ICatsService CatsService

<PageTitle>Our Males | Bagheera's Dream</PageTitle>

<HeadContent>
    <meta name="description"
          content="Lernen Sie unsere wunderschönen British Shorthair Kater kennen. Entdecken Sie ihre Charaktere, Fellfarben und besonderen Eigenschaften bei Bagheera's Dream." />

    <link rel="canonical" href="https://bagheerasdream.de/cats/males" />

    <meta property="og:title"
          content="Unsere British Shorthair Kater | Bagheera's Dream" />

    <meta property="og:description"
          content="Entdecken Sie unsere männlichen British Shorthair Katzen und lernen Sie unsere Zuchtkater kennen." />

    <meta property="og:url"
          content="https://bagheerasdream.de/cats/males" />

    <meta property="og:image"
          content="https://bagheerasdream.de/images/home/5.jpg" />

    <meta property="og:type" content="website" />
</HeadContent>

<section class="males-page">

    <!-- HEADER -->

    <div class="males-header">

        <span class="section-eyebrow">
            THE GENTLEMEN OF BAGHEERA'S DREAM
        </span>

        <h1>
            OUR <span>MALES</span>
        </h1>

        <p>
            Meet our handsome gentlemen – proudly showing off their signature chunky cheeks,
            chubby charm and strong muscular build.
        </p>

    </div>


    <!-- CATS GRID -->

    <div class="males-container">

        @if (IsLoading)
        {
            <div class="empty-males">
                <p>Loading...</p>
            </div>
        }
        else if (Cats.Any())
        {
            <div class="cats-grid">
                @foreach (var cat in Cats)
                {
                    <CatCard
                        Name="@cat.Name"
                        Birthday="@cat.Birthday.ToDateTime(TimeOnly.MinValue)"
                        Color="@cat.Color.ToDisplayName()"
                        Breed="@cat.Breed.ToDisplayName()"
                        ProfileImage="@cat.ProfileImage"
                        DetailsUrl="@($"/cats/{cat.CatId}")" />
                }
            </div>
        }
        else
        {
            <div class="empty-males">
                <h3>No males to display yet.</h3>
                <p>Our family is growing. Check back soon.</p>
            </div>
        }

    </div>


    <!-- FOOTER DECORATION -->

    <div class="males-bottom">

        <span>BRITISH SHORTHAIR</span>

        <span>RAISED WITH LOVE & CARE</span>

    </div>

</section>


@code {

    private List<CatListDto> Cats = new();
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Cats = (await CatsService.GetMalesAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}
