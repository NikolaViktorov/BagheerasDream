@page "/cats/females"
@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.DTOs.Cats
@using BagheerasDream.Web.Extensions
@inject ICatsService CatsService
@inject IStringLocalizer<Females> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer["MetaDescription"]" />
    <link rel="canonical" href="https://bagheerasdream.de/cats/females" />

    <meta property="og:title" content="@Localizer["OgTitle"]" />
    <meta property="og:description" content="@Localizer["OgDescription"]" />
    <meta property="og:url" content="https://bagheerasdream.de/cats/females" />
    <meta property="og:image" content="https://bagheerasdream.de/images/home/5.jpg" />
    <meta property="og:type" content="website" />
</HeadContent>

<section class="females-page">

    <!-- HEADER -->
    <div class="females-header">
        <span class="section-eyebrow">
            @Localizer["HeaderEyebrow"]
        </span>

        <h1>
            @Localizer["Heading"]
            <span>@Localizer["HeadingHighlight"]</span>
        </h1>

        <p>
            @Localizer["Description"]
        </p>
    </div>

    <!-- CATS GRID -->
    <div class="females-container">
        @if (IsLoading)
        {
            <div class="empty-females">
                <p>@Localizer["Loading"]</p>
            </div>
        }
        else if (Cats.Any())
        {
            <div class="cats-grid">
                @foreach (var cat in Cats)
                {
                    <CatCard Name="@cat.Name"
                             Birthday="@cat.Birthday.ToDateTime(TimeOnly.MinValue)"
                             Color="@cat.Color.ToDisplayName()"
                             Breed="@cat.Breed.ToDisplayName()"
                             ProfileImage="@cat.ProfileImage"
                             DetailsUrl="@($"/cats/{cat.CatId}")" />
                }
            </div>
        }
        else
        {
            <div class="empty-females">
                <h3>@Localizer["EmptyHeading"]</h3>
                <p>@Localizer["EmptyDescription"]</p>
            </div>
        }
    </div>

    <!-- FOOTER DECORATION -->
    <div class="females-bottom">
        <span>@Localizer["FooterBreed"]</span>
        <span>@Localizer["FooterNote"]</span>
    </div>

</section>

@code {
    private List<CatListDto> Cats = new();
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Cats = (await CatsService.GetFemalesAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}
