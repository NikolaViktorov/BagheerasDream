@page "/admin/litters"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@layout Layout.AdminLayout

@using BagheerasDream.Application.DTOs.Litters
@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.Interfaces.Admin

@inject ILittersService LittersService
@inject IAdminLittersService AdminLittersService
@inject IJSRuntime JS

<PageTitle>Управление на котилата | Админ панел</PageTitle>

<div class="admin-page litters-page">

    <div class="page-header">
        <div>
            <span class="page-eyebrow">УПРАВЛЕНИЕ</span>
            <h1>Котила</h1>
            <p>Управление на котилата във вашия развъдник.</p>
        </div>

        <a href="/admin/litters/create" class="btn-primary">
            <span>+</span>
            Добави котило
        </a>
    </div>

    @if (!string.IsNullOrEmpty(DeleteErrorMessage))
    {
        <div class="alert alert-danger">
            @DeleteErrorMessage
        </div>
    }

    @if (litters == null)
    {
        <div class="litters-message">
            Зареждане на котилата...
        </div>
    }
    else if (!litters.Any())
    {
        <div class="litters-empty">
            <span class="litters-empty-icon">♡</span>
            <h3>Все още няма добавени котила</h3>
            <p>Добави първото котило в развъдника.</p>

            <a href="/admin/litters/create" class="btn-primary">
                + Добави котило
            </a>
        </div>
    }
    else
    {
        <div class="litters-count">
            Общо котила: <strong>@litters.Count()</strong>
        </div>

        @* Desktop table *@
        <div class="admin-table-container litters-desktop-view">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Снимка</th>
                        <th>Име</th>
                        <th>Майка</th>
                        <th>Дата на раждане</th>
                        <th>Брой котенца</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var litter in litters)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(litter.PhotoOfLitter))
                                {
                                    <img src="@litter.PhotoOfLitter"
                                         alt="@litter.Name"
                                         class="litter-table-image" />
                                }
                                else
                                {
                                    <div class="litter-table-placeholder">♡</div>
                                }
                            </td>

                            <td class="litter-name-cell">@litter.Name</td>

                            <td>@litter.MotherName</td>

                            <td>@litter.Birthday.ToString("dd.MM.yyyy")</td>

                            <td>
                                <span class="litter-count-badge">
                                    @litter.KittenCount
                                </span>
                            </td>

                            <td>
                                <div class="litter-actions">
                                    <a href="@($"/admin/litters/edit/{litter.LitterId}")"
                                       class="btn-edit">
                                        Редактирай
                                    </a>

                                    <button class="btn-delete"
                                            @onclick="() => DeleteLitter(litter.LitterId)">
                                        Изтрий
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobile cards *@
        <div class="litters-mobile-view">
            @foreach (var litter in litters)
            {
                <article class="litter-mobile-card">

                    <div class="litter-mobile-header">

                        @if (!string.IsNullOrEmpty(litter.PhotoOfLitter))
                        {
                            <img src="@litter.PhotoOfLitter"
                                 alt="@litter.Name"
                                 class="litter-mobile-image" />
                        }
                        else
                        {
                            <div class="litter-mobile-placeholder">♡</div>
                        }

                        <div class="litter-mobile-title">
                            <h3>@litter.Name</h3>
                            <span>@litter.MotherName</span>
                        </div>

                    </div>

                    <div class="litter-mobile-details">

                        <div>
                            <span>Дата на раждане</span>
                            <strong>@litter.Birthday.ToString("dd.MM.yyyy")</strong>
                        </div>

                        <div>
                            <span>Брой котенца</span>
                            <strong class="litter-mobile-count">
                                @litter.KittenCount
                            </strong>
                        </div>

                    </div>

                    <div class="litter-mobile-actions">

                        <a href="@($"/admin/litters/edit/{litter.LitterId}")"
                           class="btn-edit">
                            Редактирай
                        </a>

                        <button class="btn-delete"
                                @onclick="() => DeleteLitter(litter.LitterId)">
                            Изтрий
                        </button>

                    </div>

                </article>
            }
        </div>
    }

</div>

@code {
    private IEnumerable<LitterListDto>? litters;

    private string? DeleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        litters = await LittersService.GetAllAsync();
    }

    private async Task DeleteLitter(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Сигурни ли сте, че искате да изтриете това котило и всички котенца в него?");

        if (!confirmed)
            return;

        try
        {
            var success = await AdminLittersService.DeleteAsync(id);

            if (success)
            {
                DeleteErrorMessage = null;
                litters = await LittersService.GetAllAsync();
            }
            else
            {
                DeleteErrorMessage = "Котилото не беше намерено.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DELETE LITTER ERROR: {ex}");

            DeleteErrorMessage = "Възникна грешка при изтриването на котилото. Моля, опитайте отново.";
        }
    }
}