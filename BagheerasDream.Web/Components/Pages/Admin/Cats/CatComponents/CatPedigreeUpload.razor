@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="form-group">
    <label>Родословно дърво (Pedigree)</label>

    <InputFile id="catPedigreeInput"
               OnChange="HandlePedigreeSelection"
               accept=".jpg,.jpeg,.png,.webp"
               class="form-control" />

    @if (!string.IsNullOrEmpty(PreviewUrl))
    {
        <div class="image-preview">
            <img src="@PreviewUrl"
                 alt="Преглед на родословното дърво"
                 style="max-width: 250px; margin-top: 15px;" />
        </div>
    }
    else if (!string.IsNullOrEmpty(CurrentImage))
    {
        <div class="image-preview">
            <img src="@CurrentImage"
                 alt="Текущо родословно дърво"
                 style="max-width: 250px; margin-top: 15px;" />
        </div>
    }
</div>

@code {
    [Parameter]
    public string? CurrentImage { get; set; }

    [Parameter]
    public EventCallback<IBrowserFile> OnImageSelected { get; set; }

    private string? PreviewUrl;

    private async Task HandlePedigreeSelection(InputFileChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(PreviewUrl))
        {
            await JS.InvokeVoidAsync("imagePreview.revoke", PreviewUrl);
        }

        await OnImageSelected.InvokeAsync(e.File);

        PreviewUrl = await JS.InvokeAsync<string>(
            "imagePreview.createFromInput",
            "catPedigreeInput");
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(PreviewUrl))
        {
            await JS.InvokeVoidAsync("imagePreview.revoke", PreviewUrl);
        }
    }
}