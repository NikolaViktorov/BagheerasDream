@page "/admin/kittens"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@layout Layout.AdminLayout

@using BagheerasDream.Application.DTOs.Admin.Kittens
@using BagheerasDream.Application.Interfaces.Admin

@inject IAdminKittensService AdminKittensService
@inject IJSRuntime JS

<PageTitle>Manage Kittens | Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div>
            <h1>Manage Kittens</h1>
            <p>Manage your cattery's kittens.</p>
        </div>

        <a href="/admin/kittens/create" class="btn-primary">
            + Add New Kitten
        </a>
    </div>

    @if (!string.IsNullOrEmpty(DeleteErrorMessage))
    {
        <div class="alert alert-danger">
            @DeleteErrorMessage
        </div>
    }

    @if (kittens == null)
    {
        <p>Loading kittens...</p>
    }
    else if (!kittens.Any())
    {
        <p>No kittens found.</p>
    }
    else
    {
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Color</th>
                        <th>Litter</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var kitten in kittens)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(kitten.ProfileImage))
                                {
                                    <img src="@kitten.ProfileImage"
                                         alt="@kitten.Name"
                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                }
                                else
                                {
                                    <span>No photo</span>
                                }
                            </td>

                            <td>@(string.IsNullOrWhiteSpace(kitten.Name) ? "Unnamed" : kitten.Name)</td>
                            <td>@kitten.Color</td>
                            <td>@kitten.LitterName</td>
                            <td>@kitten.Status</td>

                            <td>
                                <a href="@($"/admin/kittens/edit/{kitten.KittenId}")"
                                   class="btn-edit">
                                    Edit
                                </a>

                                <button class="btn-delete"
                                        @onclick="() => DeleteKitten(kitten.KittenId)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IEnumerable<KittenListAdminDto>? kittens;
    private string? DeleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        kittens = await AdminKittensService.GetAllAsync();
    }

    private async Task DeleteKitten(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this kitten?");

        if (!confirmed)
            return;

        try
        {
            var success = await AdminKittensService.DeleteAsync(id);

            if (success)
            {
                DeleteErrorMessage = null;
                kittens = await AdminKittensService.GetAllAsync();
            }
            else
            {
                DeleteErrorMessage = "This kitten could not be found.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DELETE KITTEN ERROR: {ex}");
            DeleteErrorMessage = "An error occurred while deleting the kitten.";
        }
    }
}