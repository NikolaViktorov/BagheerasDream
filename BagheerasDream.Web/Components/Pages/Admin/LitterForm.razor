@page "/admin/litters/create"
@page "/admin/litters/edit/{Id:guid}"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@implements IAsyncDisposable

@layout Layout.AdminLayout

@using BagheerasDream.Web.Components.Pages.Admin.LitterComponents
@using BagheerasDream.Application.DTOs.Admin.Litters
@using BagheerasDream.Application.DTOs.Cats
@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.Interfaces.Admin
@using BagheerasDream.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms

@inject IImageUploadService ImageUploadService
@inject ICatsService CatsService
@inject IAdminLittersService AdminLittersService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Форма за котило | Админ панел</PageTitle>

<div class="admin-page litter-form-page">
    <div class="page-header">
        <div>
            <h1>@(IsEditMode ? "Редактиране на котило" : "Добавяне на ново котило")</h1>
            <p>Управление на информацията за котилото.</p>
        </div>

        <a href="/admin/litters" class="btn-secondary">
            Обратно към котилата
        </a>
    </div>

    @if (IsLoading)
    {
        <p>Зареждане...</p>
    }
    else
    {
        <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <div class="admin-form">

            <div class="form-group">
                <label>Име на котилото</label>
                <InputText @bind-Value="Model.Name"
                           class="form-control" />
                <ValidationMessage For="@(() => Model.Name)" />
            </div>

            <div class="form-group">
                <label>Дата на раждане</label>
                <InputDate @bind-Value="Model.Birthday"
                           class="form-control" />
            </div>

            <div class="form-group">
                <label>Майка</label>

                <InputSelect @bind-Value="Model.MotherId"
                             class="form-control">
                    <option value="@Guid.Empty">-- Изберете майка --</option>

                    @foreach (var cat in AvailableCats.Where(c =>
                        c.Gender == Gender.Female))
                    {
                        <option value="@cat.CatId">@cat.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Тип баща</label>

                <InputSelect @bind-Value="Model.HasInternalFather"
                             class="form-control">
                    <option value="true">Вътрешен баща</option>
                    <option value="false">Външен баща</option>
                </InputSelect>
            </div>

            @if (Model.HasInternalFather)
            {
                <div class="form-group">
                    <label>Баща</label>

                    <InputSelect @bind-Value="Model.FatherId"
                                 class="form-control">
                        <option value="">-- Изберете баща --</option>

                        @foreach (var cat in AvailableCats.Where(c =>
                            c.Gender == Gender.Male))
                        {
                            <option value="@cat.CatId">@cat.Name</option>
                        }
                    </InputSelect>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Име на външния баща</label>

                    <InputText @bind-Value="Model.ExternalFatherName"
                               class="form-control" />
                </div>

                <div class="form-group">
                    <label>Развъдник на бащата</label>

                    <InputText @bind-Value="Model.ExternalFatherCattery"
                               class="form-control" />
                </div>
            }

            <div class="form-group">
                <label>Снимка на котилото</label>

                <InputFile id="litterImageInput"
                           OnChange="HandleImageSelection"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="form-control" />

                @if (!string.IsNullOrEmpty(ImagePreviewUrl))
                {
                    <div class="image-preview">
                        <img src="@ImagePreviewUrl"
                             alt="Преглед на снимката"
                             style="max-width: 250px; margin-top: 15px;" />
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.PhotoOfLitter))
                {
                    <div class="image-preview">
                        <img src="@Model.PhotoOfLitter"
                             alt="Текуща снимка"
                             style="max-width: 250px; margin-top: 15px;" />
                    </div>
                }
            </div>

            @if (IsEditMode)
            {
                <LitterGalleryManager LitterId="@Id!.Value" />
            }

            <div class="form-group">
                <label>Описание</label>

                <InputTextArea @bind-Value="Model.Description"
                               class="form-control"
                               rows="5" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">
                    @(IsEditMode ? "Запази промените" : "Създай котило")
                </button>

                <a href="/admin/litters" class="btn-secondary">
                    Отказ
                </a>
            </div>

        </div>
    </EditForm>
    }
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;

    private LitterFormDto Model = new()
    {
        Birthday = DateOnly.FromDateTime(DateTime.Today)
    };

    private bool IsLoading = true;

    private IEnumerable<CatListDto> AvailableCats = [];

    private IBrowserFile? SelectedImage;

    private string? ImagePreviewUrl;

    private string? ErrorMessage;

    private const long MaxImageSize = 15 * 1024 * 1024;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        AvailableCats = await CatsService.GetAllAsync();

        if (IsEditMode)
        {
            var litter = await AdminLittersService.GetForEditAsync(Id!.Value);

            if (litter is null)
            {
                Navigation.NavigateTo("/admin/litters");
                return;
            }

            Model = litter;
        }
        else
        {
            Model = new LitterFormDto()
            {
                Birthday = DateOnly.FromDateTime(DateTime.Today)
            };
        }

        IsLoading = false;
    }

    private async Task HandleSubmit()
    {
        ErrorMessage = null;

        string? oldImagePath = IsEditMode ? Model.PhotoOfLitter : null;
        string? newImagePath = null;

        try
        {
            if (SelectedImage is not null)
            {
                await using var stream =
                    SelectedImage.OpenReadStream(MaxImageSize);

                newImagePath = await ImageUploadService.UploadAsync(
                    stream,
                    SelectedImage.Name,
                    "litters");

                Model.PhotoOfLitter = newImagePath;
            }

            bool success;

            if (IsEditMode)
            {
                success = await AdminLittersService.UpdateAsync(Model);
            }
            else
            {
                await AdminLittersService.CreateAsync(Model);
                success = true;
            }

            if (!success)
            {
                ErrorMessage = "Котилото не беше намерено или не можа да бъде обновено.";

                if (newImagePath is not null)
                    await ImageUploadService.DeleteAsync(newImagePath);

                Model.PhotoOfLitter = oldImagePath;
                return;
            }

            if (oldImagePath is not null && newImagePath is not null)
            {
                await ImageUploadService.DeleteAsync(oldImagePath);
            }

            Navigation.NavigateTo("/admin/litters");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving litter: {ex}");

            if (newImagePath is not null)
            {
                await ImageUploadService.DeleteAsync(newImagePath);
                Model.PhotoOfLitter = oldImagePath;
            }

            ErrorMessage = "Възникна грешка при запазването. Моля, проверете данните и опитайте отново.";
        }
    }

    private async Task HandleImageSelection(InputFileChangeEventArgs e)
    {
        SelectedImage = e.File;

        if (!string.IsNullOrEmpty(ImagePreviewUrl))
        {
            await JS.InvokeVoidAsync(
                "imagePreview.revoke",
                ImagePreviewUrl);
        }

        ImagePreviewUrl = await JS.InvokeAsync<string>(
            "imagePreview.createFromInput",
            "litterImageInput");
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(ImagePreviewUrl))
        {
            await JS.InvokeVoidAsync(
                "imagePreview.revoke",
                ImagePreviewUrl);

            ImagePreviewUrl = null;
        }
    }
}
