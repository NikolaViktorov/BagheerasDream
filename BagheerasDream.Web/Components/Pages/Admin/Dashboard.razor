@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@layout Layout.AdminLayout

@using BagheerasDream.Application.DTOs.Admin
@using BagheerasDream.Application.Interfaces
@inject IDashboardService DashboardService

<PageTitle>Табло | BagheerasDream</PageTitle>

<div class="dashboard-page">
    <div class="dashboard-header">
        <div>
            <span class="dashboard-eyebrow">ОБЩ ПРЕГЛЕД</span>
            <h1>Табло</h1>
            <p>Добре дошли в административния панел на BagheerasDream.</p>
        </div>
    </div>

    @if (IsLoading)
    {
        <p>Зареждане на статистиката...</p>
    }
    else if (Stats is not null)
    {
        <section class="dashboard-section">
            <h2>Котки</h2>

            <div class="dashboard-grid">
                <div class="dashboard-card">
                    <span>Общо котки</span>
                    <strong>@Stats.TotalCats</strong>
                </div>

                <div class="dashboard-card">
                    <span>Мъжки котки</span>
                    <strong>@Stats.MaleCats</strong>
                </div>

                <div class="dashboard-card">
                    <span>Женски котки</span>
                    <strong>@Stats.FemaleCats</strong>
                </div>
            </div>
        </section>

        <section class="dashboard-section">
            <h2>Котила и котенца</h2>

            <div class="dashboard-grid">
                <div class="dashboard-card">
                    <span>Общо котила</span>
                    <strong>@Stats.TotalLitters</strong>
                </div>

                <div class="dashboard-card">
                    <span>Общо котенца</span>
                    <strong>@Stats.TotalKittens</strong>
                </div>

                <div class="dashboard-card">
                    <span>Свободни</span>
                    <strong>@Stats.AvailableKittens</strong>
                </div>

                <div class="dashboard-card">
                    <span>Резервирани</span>
                    <strong>@Stats.ReservedKittens</strong>
                </div>

                <div class="dashboard-card">
                    <span>Продадени</span>
                    <strong>@Stats.SoldKittens</strong>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private DashboardStatsDto? Stats;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        Stats = await DashboardService.GetStatsAsync();
        IsLoading = false;
    }
}
