@page "/admin/kittens"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@layout Layout.AdminLayout

@using BagheerasDream.Application.DTOs.Admin.Kittens
@using BagheerasDream.Application.Interfaces.Admin
@using BagheerasDream.Web.Extensions

@inject IAdminKittensService AdminKittensService
@inject IJSRuntime JS

<PageTitle>Управление на котенцата | Админ панел</PageTitle>

<div class="admin-page kittens-page">
    <div class="page-header">
        <div>
            <h1>Управление на котенцата</h1>
            <p>Управление на котенцата във вашия развъдник.</p>
        </div>

        <a href="/admin/kittens/create" class="btn-primary">
            + Добави ново котенце
        </a>
    </div>

    @if (!string.IsNullOrEmpty(DeleteErrorMessage))
    {
        <div class="alert alert-danger">
            @DeleteErrorMessage
        </div>
    }

    @if (kittens == null)
    {
        <div class="loading-state">
            Зареждане на котенцата...
        </div>
    }
    else if (!kittens.Any())
    {
        <div class="empty-state">
            <h3>Все още няма добавени котенца</h3>
            <p>Добавете първото котенце във вашия развъдник.</p>

            <a href="/admin/kittens/create" class="btn-primary">
                + Добави котенце
            </a>
        </div>
    }
    else
    {
        <div class="list-summary">
            <span>Общо котенца</span>
            <strong>@kittens.Count()</strong>
        </div>

        @* Desktop / Tablet table *@
        <div class="admin-table-container kittens-desktop-view">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Снимка</th>
                        <th>Име</th>
                        <th>Цвят</th>
                        <th>Пол</th>
                        <th>Котило</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var kitten in kittens)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(kitten.ProfileImage))
                                {
                                    <img src="@kitten.ProfileImage"
                                         alt="@kitten.Name"
                                         class="kitten-thumbnail" />
                                }
                                else
                                {
                                    <div class="no-image">Няма снимка</div>
                                }
                            </td>

                            <td>
                                <strong>
                                    @(string.IsNullOrWhiteSpace(kitten.Name)
                                        ? "Без име"
                                        : kitten.Name)
                                </strong>
                            </td>

                            <td>@kitten.Color.ToDisplayName()</td>

                            <td>
                                @(kitten.Gender == BagheerasDream.Domain.Enums.Gender.Male
                                    ? "Мъжки"
                                    : "Женски")
                            </td>

                            <td>@kitten.LitterName</td>

                            <td>
                                <span class="status-badge status-@kitten.Status.ToString().ToLowerInvariant()">
                                    @kitten.Status
                                </span>
                            </td>

                            <td>
                                <div class="table-actions">
                                    <a href="@($"/admin/kittens/edit/{kitten.KittenId}")"
                                       class="btn-edit">
                                        Редактирай
                                    </a>

                                    <button class="btn-delete"
                                            @onclick="() => DeleteKitten(kitten.KittenId)">
                                        Изтрий
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobile cards *@
        <div class="kittens-mobile-view">
            @foreach (var kitten in kittens)
            {
                <article class="kitten-admin-card">

                    <div class="kitten-card-header">
                        @if (!string.IsNullOrWhiteSpace(kitten.ProfileImage))
                        {
                            <img src="@kitten.ProfileImage"
                                 alt="@kitten.Name"
                                 class="kitten-card-image" />
                        }
                        else
                        {
                            <div class="kitten-card-placeholder">
                                Няма снимка
                            </div>
                        }

                        <div class="kitten-card-title">
                            <h3>
                                @(string.IsNullOrWhiteSpace(kitten.Name)
                                    ? "Без име"
                                    : kitten.Name)
                            </h3>

                            <span class="status-badge status-@kitten.Status.ToString().ToLowerInvariant()">
                                @kitten.Status
                            </span>
                        </div>
                    </div>

                    <div class="kitten-card-details">
                        <div class="detail-item">
                            <span>Цвят</span>
                            <strong>@kitten.Color.ToDisplayName()</strong>
                        </div>

                        <div class="detail-item">
                            <span>Пол</span>
                            <strong>
                                @(kitten.Gender == BagheerasDream.Domain.Enums.Gender.Male
                                    ? "Мъжки"
                                    : "Женски")
                            </strong>
                        </div>

                        <div class="detail-item full-width">
                            <span>Котило</span>
                            <strong>@kitten.LitterName</strong>
                        </div>
                    </div>

                    <div class="kitten-card-actions">
                        <a href="@($"/admin/kittens/edit/{kitten.KittenId}")"
                           class="btn-edit">
                            Редактирай
                        </a>

                        <button class="btn-delete"
                                @onclick="() => DeleteKitten(kitten.KittenId)">
                            Изтрий
                        </button>
                    </div>

                </article>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<KittenListAdminDto>? kittens;
    private string? DeleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        kittens = await AdminKittensService.GetAllAsync();
    }

    private async Task DeleteKitten(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Сигурни ли сте, че искате да изтриете това котенце?");

        if (!confirmed)
            return;

        try
        {
            var success = await AdminKittensService.DeleteAsync(id);

            if (success)
            {
                DeleteErrorMessage = null;
                kittens = await AdminKittensService.GetAllAsync();
            }
            else
            {
                DeleteErrorMessage = "Котенцето не беше намерено.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DELETE KITTEN ERROR: {ex}");

            DeleteErrorMessage = "Възникна грешка при изтриването на котенцето.";
        }
    }
}