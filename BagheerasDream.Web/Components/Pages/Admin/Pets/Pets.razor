@page "/admin/pets"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@layout Layout.AdminLayout

@using BagheerasDream.Application.DTOs.Pets
@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.Interfaces.Admin
@using BagheerasDream.Web.Extensions
@using BagheerasDream.Domain.Enums

@inject IPetsService PetsService
@inject IAdminPetsService AdminPetsService
@inject IJSRuntime JS

<PageTitle>Управление на любимците | Админ панел</PageTitle>

<div class="admin-page pets-admin-page">

    <div class="page-header">
        <div>
            <span class="page-eyebrow">УПРАВЛЕНИЕ</span>
            <h1>Любимци</h1>
            <p>Добавяне, редактиране и управление на домашните любимци.</p>
        </div>

        <a href="/admin/pets/create" class="btn-primary">
            <span>+</span>
            Добави любимец
        </a>
    </div>

    @if (!string.IsNullOrEmpty(DeleteErrorMessage))
    {
        <div class="alert alert-danger">
            @DeleteErrorMessage
        </div>
    }

    @if (pets == null)
    {
        <div class="pets-message">
            <span>Зареждане на любимците...</span>
        </div>
    }
    else if (!pets.Any())
    {
        <div class="pets-empty">
            <span class="pets-empty-icon">♡</span>
            <h3>Все още няма добавени любимци</h3>
            <p>Добави първия домашен любимец в семейството.</p>

            <a href="/admin/pets/create" class="btn-primary">
                + Добави любимец
            </a>
        </div>
    }
    else
    {
        <div class="pets-count">
            Общо любимци: <strong>@pets.Count()</strong>
        </div>

        @* Desktop table *@
        <div class="admin-table-container pets-desktop-view">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Име</th>
                        <th>Пол</th>
                        <th>Порода</th>
                        <th>Цвят</th>
                        <th>Дата на раждане</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var pet in pets)
                    {
                        <tr>
                            <td class="pet-name-cell">@pet.Name</td>

                            <td>
                                @(pet.Gender == Gender.Male ? "Мъжки" : "Женски")
                            </td>

                            <td>@pet.Breed.ToDisplayName()</td>

                            <td>@pet.Color.ToDisplayName()</td>

                            <td>@pet.Birthday.ToString("dd.MM.yyyy")</td>

                            <td>
                                <div class="pet-actions">
                                    <a href="@($"/admin/pets/edit/{pet.PetId}")"
                                       class="btn-edit">
                                        Редактирай
                                    </a>

                                    <button class="btn-delete"
                                            @onclick="() => DeletePet(pet.PetId)">
                                        Изтрий
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobile cards *@
        <div class="pets-mobile-view">
            @foreach (var pet in pets)
            {
                <article class="pet-mobile-card">

                    <div class="pet-mobile-info">
                        <h3>@pet.Name</h3>

                        <span class="pet-gender-badge">
                            @(pet.Gender == Gender.Male ? "Мъжки" : "Женски")
                        </span>
                    </div>

                    <div class="pet-mobile-details">

                        <div>
                            <span>Порода</span>
                            <strong>@pet.Breed</strong>
                        </div>

                        <div>
                            <span>Цвят</span>
                            <strong>@pet.Color.ToDisplayName()</strong>
                        </div>

                        <div>
                            <span>Роден/а на</span>
                            <strong>@pet.Birthday.ToString("dd.MM.yyyy")</strong>
                        </div>

                    </div>

                    <div class="pet-mobile-actions">
                        <a href="@($"/admin/pets/edit/{pet.PetId}")"
                           class="btn-edit">
                            Редактирай
                        </a>

                        <button class="btn-delete"
                                @onclick="() => DeletePet(pet.PetId)">
                            Изтрий
                        </button>
                    </div>

                </article>
            }
        </div>
    }

</div>

@code {
    private IEnumerable<PetListDto>? pets;

    private string? DeleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        pets = await PetsService.GetAllAsync();
    }

    private async Task DeletePet(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Сигурни ли сте, че искате да изтриете този любимец?");

        if (!confirmed)
            return;

        var success = await AdminPetsService.DeleteAsync(id);

        if (success)
        {
            DeleteErrorMessage = null;
            pets = await PetsService.GetAllAsync();
        }
        else
        {
            DeleteErrorMessage = "Възникна грешка при изтриването на любимеца.";
        }
    }
}