@page "/admin/cats/create"
@page "/admin/cats/edit/{Id:guid}"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@layout Layout.AdminLayout

@using BagheerasDream.Web.Components.Pages.Admin.CatComponents
@using BagheerasDream.Application.DTOs.Admin.Cats
@using BagheerasDream.Application.Interfaces.Admin
@using BagheerasDream.Domain.Enums
@using BagheerasDream.Web.Extensions
@using BagheerasDream.Application.DTOs.Cats
@using BagheerasDream.Application.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IImageUploadService ImageUploadService
@inject ICatsService CatsService
@inject IAdminCatsService AdminCatsService
@inject NavigationManager Navigation


<PageTitle>Форма за котка | Админ панел</PageTitle>

<div class="admin-page cat-form-page">
    <div class="page-header">
        <div>
            <h1>@(IsEditMode ? "Редактиране на котка" : "Добавяне на нова котка")</h1>
            <p>Управление на информацията за котката.</p>
        </div>

        <a href="/admin/cats" class="btn-secondary">
            Обратно към котките
        </a>
    </div>
</div>

@if (IsLoading)
{
    <p>Зареждане...</p>
}
else
{
    <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <div class="admin-form cat-form-layout">

            <div class="form-group">
                <label>Име</label>
                <InputText @bind-Value="Model.Name" class="form-control" />
                <ValidationMessage For="@(() => Model.Name)" />
            </div>

            <div class="form-group">
                <label>Дата на раждане</label>
                <InputDate @bind-Value="Model.Birthday" class="form-control" />
            </div>

            <div class="form-group">
                <label>Пол</label>
                <InputSelect @bind-Value="Model.Gender" class="form-control">
                    @foreach (var gender in Enum.GetValues<Gender>())
                    {
                        <option value="@gender">@gender</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Цвят</label>
                <InputSelect @bind-Value="Model.Color" class="form-control">
                    @foreach (var color in Enum.GetValues<CatColor>())
                    {
                        <option value="@color">@color.ToDisplayName()</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Порода</label>
                <InputSelect @bind-Value="Model.Breed" class="form-control">
                    @foreach (var breed in Enum.GetValues<Breed>())
                    {
                        <option value="@breed">@breed</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Баща</label>
                <InputSelect @bind-Value="Model.FatherId" class="form-control">
                    <option value="">-- Изберете баща --</option>

                    @foreach (var cat in AvailableCats.Where(c =>
                        c.Gender == Gender.Male && c.CatId != Model.CatId))
                    {
                        <option value="@cat.CatId">@cat.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Майка</label>
                <InputSelect @bind-Value="Model.MotherId" class="form-control">
                    <option value="">-- Изберете майка --</option>

                    @foreach (var cat in AvailableCats.Where(c =>
                        c.Gender == Gender.Female && c.CatId != Model.CatId))
                    {
                        <option value="@cat.CatId">@cat.Name</option>
                    }
                </InputSelect>
            </div>

            <CatProfileImageUpload CurrentImage="@Model.ProfileImage"
                       OnImageSelected="HandleImageSelected" />

            <CatPedigreeUpload CurrentImage="@Model.PedigreeImage"
                   OnImageSelected="HandlePedigreeImageSelected" />

            @if (IsEditMode)
            {
                <CatGalleryManager CatId="Id!.Value" />
            }

            <div class="form-group">
                <label>Описание</label>
                <InputTextArea @bind-Value="Model.Description" class="form-control" rows="5" />
            </div>

            <div class="form-actions cat-form-actions">
                <button type="submit" class="btn-primary">
                    @(IsEditMode ? "Запази промените" : "Добави котка")
                </button>

                <a href="/admin/cats" class="btn-secondary">
                    Отказ
                </a>
            </div>

        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;

    private CatFormDto Model = new()
    {
        Birthday = DateOnly.FromDateTime(DateTime.Today)
    };

    private bool IsLoading = true;

    private IEnumerable<CatListDto> AvailableCats = [];

    private IBrowserFile? SelectedImage;

    private const long MaxImageSize = 15 * 1024 * 1024;

    private string? ErrorMessage;

    private IBrowserFile? SelectedPedigreeImage;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        SelectedImage = null;
        SelectedPedigreeImage = null;

        AvailableCats = await CatsService.GetAllAsync();

        if (IsEditMode)
        {
            var cat = await AdminCatsService.GetForEditAsync(Id!.Value);

            if (cat is null)
            {
                Navigation.NavigateTo("/admin/cats");
                return;
            }

            Model = cat;
        }
        else
        {
            Model = new CatFormDto
            {
                Birthday = DateOnly.FromDateTime(DateTime.Today)
            };
        }

        IsLoading = false;
    }

    private async Task HandleSubmit()
    {
        ErrorMessage = null;

        string? oldImagePath = IsEditMode ? Model.ProfileImage : null;
        string? oldPedigreePath = IsEditMode ? Model.PedigreeImage : null;

        string? newImagePath = null;
        string? newPedigreePath = null;

        try
        {
            // Качване на профилна снимка
            if (SelectedImage is not null)
            {
                await using var stream = SelectedImage.OpenReadStream(MaxImageSize);

                newImagePath = await ImageUploadService.UploadAsync(
                    stream,
                    SelectedImage.Name,
                    "cats");

                Model.ProfileImage = newImagePath;
            }

            // Качване на родословие
            if (SelectedPedigreeImage is not null)
            {
                await using var stream = SelectedPedigreeImage.OpenReadStream(MaxImageSize);

                newPedigreePath = await ImageUploadService.UploadAsync(
                    stream,
                    SelectedPedigreeImage.Name,
                    "cat-pedigrees");

                Model.PedigreeImage = newPedigreePath;
            }

            bool success;

            if (IsEditMode)
            {
                success = await AdminCatsService.UpdateAsync(Model);
            }
            else
            {
                await AdminCatsService.CreateAsync(Model);
                success = true;
            }

            if (!success)
            {
                ErrorMessage = "Котката не беше намерена или не можа да бъде обновена.";

                if (newImagePath is not null)
                    await ImageUploadService.DeleteAsync(newImagePath);

                if (newPedigreePath is not null)
                    await ImageUploadService.DeleteAsync(newPedigreePath);

                Model.ProfileImage = oldImagePath;
                Model.PedigreeImage = oldPedigreePath;

                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving cat: {ex}");

            if (newImagePath is not null)
                await ImageUploadService.DeleteAsync(newImagePath);

            if (newPedigreePath is not null)
                await ImageUploadService.DeleteAsync(newPedigreePath);

            Model.ProfileImage = oldImagePath;
            Model.PedigreeImage = oldPedigreePath;

            ErrorMessage = "Възникна грешка при запазването. Моля, проверете данните и опитайте отново.";
            return;
        }

        // Изтриваме старите изображения едва след успешно запазване
        // Грешка при почистването не трябва да отменя успешно запазената котка

        if (oldImagePath is not null && newImagePath is not null)
        {
            try
            {
                await ImageUploadService.DeleteAsync(oldImagePath);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting old profile image: {ex}");
            }
        }

        if (oldPedigreePath is not null && newPedigreePath is not null)
        {
            try
            {
                await ImageUploadService.DeleteAsync(oldPedigreePath);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting old pedigree image: {ex}");
            }
        }

        Navigation.NavigateTo("/admin/cats");
    }

    private Task HandleImageSelected(IBrowserFile file)
    {
        SelectedImage = file;
        return Task.CompletedTask;
    }

    private Task HandlePedigreeImageSelected(IBrowserFile file)
    {
        SelectedPedigreeImage = file;
        return Task.CompletedTask;
    }
}
