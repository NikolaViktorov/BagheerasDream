@page "/"

<PageTitle>BagheerasDream | British Shorthair</PageTitle>

<section class="hero-section">

    <div class="hero-container">

        <div class="hero-content">

            <span class="hero-eyebrow">
                THE WORLD OF BRITISH SHORTHAIR
            </span>

            <h1>
                Elegance in
                <span>Every Paw.</span>
            </h1>

            <p class="hero-description">
                Discover the beauty, charm and gentle character
                of British Shorthair cats. Welcome to the world
                of BagheerasDream.
            </p>

            <div class="hero-actions">

                <a href="/cats/males" class="btn-primary">
                    EXPLORE OUR CATS
                    <span>→</span>
                </a>

                <a href="/home/aboutus" class="btn-secondary">
                    OUR STORY
                </a>

            </div>

            <div class="hero-note">
                <span class="hero-note-line"></span>
                <span>RAISED WITH LOVE & CARE</span>
            </div>

        </div>

        <div class="hero-visual">

            <div class="hero-image-frame">

                <img src="/images/main2.jpg"
                     alt="British Shorthair cat"
                     class="hero-image" />

            </div>

            <div class="hero-image-caption">
                <span>01 — OUR BREED</span>
                <span>BRITISH SHORTHAIR</span>
            </div>

            <div class="hero-decoration"></div>

        </div>

    </div>

    <div class="hero-bottom">
        <span>DISCOVER THE BAGHEERASDREAM EXPERIENCE</span>
        <span>SCROLL TO EXPLORE ↓</span>
    </div>

</section>

