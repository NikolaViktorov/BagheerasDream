@page "/"

@inject IStringLocalizer<Home> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<HeadContent>
    <meta name="description"
          content="@Localizer["MetaDescription"]" />

    <link rel="canonical" href="https://bagheerasdream.de/" />

    <meta property="og:title"
          content="@Localizer["OgTitle"]" />

    <meta property="og:description"
          content="@Localizer["OgDescription"]" />

    <meta property="og:url" content="https://bagheerasdream.de/" />

    <meta property="og:image"
          content="https://bagheerasdream.de/images/home/5.jpg" />

    <meta property="og:type" content="website" />
</HeadContent>

<section class="hero-section">

    <div class="hero-container">

        <div class="hero-content">

            <h1>
                @Localizer["HeroWelcome"]
                <span>BAGHEERA'S DREAM</span>
            </h1>

            <p class="hero-description">
                @Localizer["HeroDescription"]
            </p>

            <div class="hero-actions">
                <a href="/home/aboutus" class="btn-primary">
                    @Localizer["HeroButton"]
                    <span>→</span>
                </a>
            </div>

            <div class="hero-note">
                <span class="hero-note-line"></span>
                <span>@Localizer["HeroNote"]</span>
            </div>

        </div>

        <div class="hero-visual">

            <div class="hero-image-frame">

                <img src="/images/home/main1.jpg"
                     alt="@Localizer["HeroImageAlt"]"
                     class="hero-image" />

            </div>

            <div class="hero-image-caption">
                <span>JR. CH. ATHINA BAGHEERA'S DREAM *DE</span>
                <span>@Localizer["HeroImageBreed"]</span>
            </div>

            <div class="hero-decoration"></div>

        </div>

    </div>

    <div class="hero-bottom">
        <span>@Localizer["HeroDiscover"]</span>
        <span>@Localizer["HeroScroll"]</span>
    </div>

</section>

<AboutSection />
<MeetOurCats />
<LatestLitters />
<WhyBagheerasDream />
<ContactCta />