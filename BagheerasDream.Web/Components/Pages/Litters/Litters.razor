@page "/litters"
@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.DTOs.Litters
@using BagheerasDream.Web.Components.Shared.Litters

@inject ILittersService LittersService

<PageTitle>Our Litters | Bagheera's Dream</PageTitle>

<HeadContent>
    <meta name="description"
          content="Entdecken Sie die aktuellen und vergangenen Würfe unserer British Shorthair Katzenzucht. Erfahren Sie mehr über unsere Kitten bei Bagheera's Dream." />

    <link rel="canonical" href="https://bagheerasdream.de/litters" />

    <meta property="og:title"
          content="British Shorthair Kitten und Würfe | Bagheera's Dream" />

    <meta property="og:description"
          content="Informieren Sie sich über unsere British Shorthair Würfe und entdecken Sie unsere Kitten." />

    <meta property="og:url"
          content="https://bagheerasdream.de/litters" />

    <meta property="og:image"
          content="https://bagheerasdream.de/images/home/5.jpg" />

    <meta property="og:type" content="website" />
</HeadContent>

<section class="litters-page">

    <header class="litters-header">

        <span class="section-eyebrow">
            THE NEWEST MEMBERS OF OUR FAMILY - 
        </span>

        <h1>OUR <span>LITTERS</span></h1>

        <p>
            Discover the little ones raised with love, care
            and dedication in our family.
        </p>

    </header>


    <div class="litters-container">
        @if (IsLoading)
        {
            <p>Loading litters...</p>
        }
        else if (LittersList.Any())
        {
            <div class="litters-grid">
                @foreach (var litter in LittersList)
                {
                    <LitterCard Item="litter" />
                }
            </div>
        }
        else
        {
            <div class="empty-litters">
                <span>♡</span>
                <h2>Beautiful moments are coming.</h2>
                <p>We currently have no litters to display.</p>
            </div>
        }
    </div>


    <div class="litters-bottom">
        <span>RAISED WITH LOVE & CARE</span>
    </div>

</section>

@code {
    private List<LitterListDto> LittersList = new();

    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LittersList = (await LittersService.GetAllAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}