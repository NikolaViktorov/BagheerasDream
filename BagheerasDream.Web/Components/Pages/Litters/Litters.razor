@page "/litters"

@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.DTOs.Litters
@using BagheerasDream.Application.DTOs.Litters
@using BagheerasDream.Web.Components.Shared.Litters

@inject ILittersService LittersService
@inject IStringLocalizer<Litters> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer["MetaDescription"]" />
    <link rel="canonical" href="https://bagheerasdream.de/litters" />
    <meta property="og:title" content="@Localizer["OgTitle"]" />
    <meta property="og:description" content="@Localizer["OgDescription"]" />
    <meta property="og:url" content="https://bagheerasdream.de/litters" />
    <meta property="og:image" content="https://bagheerasdream.de/images/home/5.jpg" />
    <meta property="og:type" content="website" />
</HeadContent>

<section class="litters-page">

    <header class="litters-header">
        <span class="section-eyebrow">
            @Localizer["HeaderEyebrow"]
        </span>

        <h1>@Localizer["Heading"] <span>@Localizer["HeadingHighlight"]</span></h1>

        <p>
            @Localizer["Description"]
        </p>
    </header>

    <div class="litters-container">
        @if (IsLoading)
        {
            <p>@Localizer["Loading"]</p>
        }
        else if (LittersList.Any())
        {
            <div class="litters-grid">
                @foreach (var litter in LittersList)
                {
                    <LitterCard Item="litter" />
                }
            </div>
        }
        else
        {
            <div class="empty-litters">
                <span>♡</span>
                <h2>@Localizer["EmptyHeading"]</h2>
                <p>@Localizer["EmptyDescription"]</p>
            </div>
        }
    </div>

    <div class="litters-bottom">
        <span>@Localizer["FooterNote"]</span>
    </div>

</section>

@code {
    private List<LitterListDto> LittersList = new();

    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LittersList = (await LittersService.GetAllAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}
