@page "/litters/{Id:guid}"
@using System.Globalization
@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.DTOs.Litters
@using BagheerasDream.Web.Components.Shared.Litters

@inject ILittersService LittersService
@inject IStringLocalizer<LitterDetails> Localizer

<PageTitle>@(CurrentLitter?.Name ?? Localizer["PageTitle"]) | Bagheera's Dream</PageTitle>

@if (IsLoading)
{
    <div class="litter-not-found">
        <h1>@Localizer["Loading"]</h1>
    </div>
}
else if (CurrentLitter is null)
{
    <div class="litter-not-found">
        <h1>@Localizer["NotFound"]</h1>
        <a href="/litters">← @Localizer["BackToLitters"]</a>
    </div>
}
else
{
    <section class="litter-details-page">

        <header class="litter-details-header">
            <div class="litter-breadcrumb">
                <a href="/">@Localizer["Home"]</a>
                <span>/</span>
                <a href="/litters">@Localizer["OurLitters"]</a>
                <span>/</span>
                <span>@CurrentLitter.Name</span>
            </div>

            <span class="section-eyebrow">@Localizer["HeroEyebrow"]</span>

            <h1>@CurrentLitter.Name<span>.</span></h1>

            <p>
                @Localizer["BornOn"] @CurrentLitter.Birthday.ToString("dd MMMM yyyy", CultureInfo.CurrentCulture)
            </p>

            <div class="litter-summary">
                <span>@Localizer["LittleOnesCount", CurrentLitter.Kittens.Count]</span>
                <span>@Localizer["RaisedWithLove"]</span>
            </div>
        </header>

        <section class="litter-kittens-section">
            <div class="litter-section-heading">
                <span class="section-eyebrow">@Localizer["MeetLittleOnes"]</span>
                <h2>@Localizer["Our"] <span>@Localizer["Kittens"]</span></h2>
                <p>@Localizer["KittensDescription"]</p>
            </div>

            @if (CurrentLitter.Kittens.Any())
            {
                <div class="kittens-grid">
                    @foreach (var kitten in CurrentLitter.Kittens)
                    {
                        <KittenCard Kitten="kitten" />
                    }
                </div>
            }
            else
            {
                <div class="empty-kittens">
                    <span>♡</span>
                    <p>@Localizer["EmptyKittens"]</p>
                </div>
            }
        </section>

        @if (OrderedGalleryImages.Any())
        {
            <section class="cat-gallery-section">
                <div class="cat-gallery-header">
                    <span class="section-eyebrow">@Localizer["PhotoCollection"]</span>
                    <h2>@Localizer["Little"] <span>@Localizer["Moments"]</span></h2>
                    <p>@Localizer["GalleryDescription", CurrentLitter.Name]</p>
                </div>

                <div class="cat-gallery">
                    @foreach (var image in OrderedGalleryImages)
                    {
                        <div class="cat-gallery-item"
                             @onclick="() => OpenLightbox(image.LitterImageId)">
                            <img src="@image.ImagePath" alt="@CurrentLitter.Name" />
                        </div>
                    }
                </div>

                @if (IsLightboxOpen)
                {
                    <div class="lightbox-overlay" @onclick="CloseLightbox">
                        <button class="lightbox-close"
                                @onclick:preventDefault="true"
                                @onclick:stopPropagation="true"
                                @onclick="CloseLightbox">
                            &times;
                        </button>

                        <button class="lightbox-arrow lightbox-prev"
                                aria-label="@Localizer["PreviousImage"]"
                                @onclick:stopPropagation="true"
                                @onclick="PreviousImage">
                            &#10094;
                        </button>

                        <img class="lightbox-image"
                             src="@SelectedGalleryImage?.ImagePath"
                             alt="@CurrentLitter.Name"
                             @onclick:stopPropagation="true" />

                        <button class="lightbox-arrow lightbox-next"
                                aria-label="@Localizer["NextImage"]"
                                @onclick:stopPropagation="true"
                                @onclick="NextImage">
                            &#10095;
                        </button>

                        <div class="lightbox-counter">
                            @(SelectedImageIndex + 1) / @OrderedGalleryImages.Count
                        </div>
                    </div>
                }
            </section>
        }

        <section class="litter-parents-section">
            <div class="litter-section-heading">
                <span class="section-eyebrow">@Localizer["WhereItBegins"]</span>
                <h2>@Localizer["MeetThe"] <span>@Localizer["Parents"]</span></h2>
            </div>

            <div class="litter-parents-grid">
                <div class="litter-parent">
                    <span>@Localizer["Mother"]</span>

                    @if (!string.IsNullOrWhiteSpace(CurrentLitter.Mother.ProfileImage))
                    {
                        @if (CurrentLitter.Mother.CatId.HasValue)
                        {
                            <a href="@($"/cats/{CurrentLitter.Mother.CatId}")">
                                <img src="@CurrentLitter.Mother.ProfileImage"
                                     alt="@CurrentLitter.Mother.Name" />
                            </a>
                        }
                        else
                        {
                            <img src="@CurrentLitter.Mother.ProfileImage"
                                 alt="@CurrentLitter.Mother.Name" />
                        }
                    }

                    @if (CurrentLitter.Mother.CatId.HasValue)
                    {
                        <a href="@($"/cats/{CurrentLitter.Mother.CatId}")">
                            <h3>@CurrentLitter.Mother.Name</h3>
                        </a>
                    }
                    else
                    {
                        <h3>@CurrentLitter.Mother.Name</h3>
                    }

                    <p>Bagheera's Dream *DE</p>
                </div>

                <div class="litter-parent">
                    <span>@Localizer["Father"]</span>

                    @if (CurrentLitter.Father is not null)
                    {
                        @if (!string.IsNullOrWhiteSpace(CurrentLitter.Father.ProfileImage))
                        {
                            @if (!CurrentLitter.Father.IsExternal &&
                                 CurrentLitter.Father.CatId.HasValue)
                            {
                                <a href="@($"/cats/{CurrentLitter.Father.CatId}")">
                                    <img src="@CurrentLitter.Father.ProfileImage"
                                         alt="@CurrentLitter.Father.Name" />
                                </a>
                            }
                            else
                            {
                                <img src="@CurrentLitter.Father.ProfileImage"
                                     alt="@CurrentLitter.Father.Name" />
                            }
                        }

                        @if (!CurrentLitter.Father.IsExternal && CurrentLitter.Father.CatId.HasValue)
                        {
                            <a href="@($"/cats/{CurrentLitter.Father.CatId}")">
                                <h3>@CurrentLitter.Father.Name</h3>
                            </a>
                        }
                        else
                        {
                            <h3>@CurrentLitter.Father.Name</h3>
                        }

                        @if (CurrentLitter.Father.IsExternal)
                        {
                            @if (!string.IsNullOrWhiteSpace(CurrentLitter.Father.CatteryName))
                            {
                                <p>@CurrentLitter.Father.CatteryName</p>
                            }
                        }
                        else
                        {
                            <p>Bagheera's Dream *DE</p>
                        }
                    }
                    else
                    {
                        <h3>@Localizer["NotSpecified"]</h3>
                    }
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(CurrentLitter.Description))
        {
            <section class="litter-description-section">
                <span class="section-eyebrow">@Localizer["OurStory"]</span>
                <h2>@Localizer["ALittle"] <span>@Localizer["AboutThem"]</span></h2>
                <p>@CurrentLitter.Description</p>
            </section>
        }

        <div class="litter-details-bottom">
            <a href="/litters">← @Localizer["BackToLitters"]</a>
            <span>@Localizer["RaisedWithLove"]</span>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private LitterDetailsDto? CurrentLitter;
    private bool IsLoading = true;
    private bool IsLightboxOpen { get; set; }
    private int SelectedImageIndex { get; set; }

    private List<LitterGalleryImageDto> OrderedGalleryImages =>
        CurrentLitter?.GalleryImages
            .OrderBy(image => image.DisplayOrder)
            .ToList() ?? [];

    private LitterGalleryImageDto? SelectedGalleryImage =>
        OrderedGalleryImages.ElementAtOrDefault(SelectedImageIndex);

    private void OpenLightbox(Guid imageId)
    {
        SelectedImageIndex = OrderedGalleryImages
            .FindIndex(image => image.LitterImageId == imageId);

        if (SelectedImageIndex >= 0)
            IsLightboxOpen = true;
    }

    private void CloseLightbox() => IsLightboxOpen = false;

    private void PreviousImage()
    {
        if (OrderedGalleryImages.Count == 0)
            return;

        SelectedImageIndex =
            (SelectedImageIndex - 1 + OrderedGalleryImages.Count)
            % OrderedGalleryImages.Count;
    }

    private void NextImage()
    {
        if (OrderedGalleryImages.Count == 0)
            return;

        SelectedImageIndex =
            (SelectedImageIndex + 1) % OrderedGalleryImages.Count;
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;

        try
        {
            CurrentLitter = await LittersService.GetByIdAsync(Id);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
