@page "/happy-families"

@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.DTOs.HappyFamilies

@inject IHappyFamiliesService HappyFamiliesService
@inject IStringLocalizer<HappyFamilies> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer["MetaDescription"]" />
    <link rel="canonical" href="https://bagheerasdream.de/happy-families" />
    <meta property="og:title" content="@Localizer["OgTitle"]" />
    <meta property="og:description" content="@Localizer["OgDescription"]" />
    <meta property="og:url" content="https://bagheerasdream.de/happy-families" />
    <meta property="og:image" content="https://bagheerasdream.de/images/home/5.jpg" />
    <meta property="og:type" content="website" />
</HeadContent>

<section class="happy-families-page">

    <div class="happy-families-header">

        <span class="section-eyebrow">
            @Localizer["HeaderEyebrow"]
        </span>

        <h1>
            @Localizer["Heading"] <span>@Localizer["HeadingHighlight"]</span>
        </h1>

        <p>
            @Localizer["Description"]
        </p>

    </div>

    <div class="happy-families-container">

        @if (IsLoading)
        {
            <div class="empty-families">
                <p>@Localizer["Loading"]</p>
            </div>
        }
        else if (Families.Any())
        {
            <div class="happy-families-grid">

                @foreach (var family in Families)
                {
                    <div class="happy-family-image" @key="family.HappyFamilyId">
                        <img src="@family.Image"
                             alt="@Localizer["ImageAlt"]"
                             loading="lazy" />
                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-families">
                <h3>@Localizer["EmptyHeading"]</h3>
                <p>@Localizer["EmptyDescription"]</p>
            </div>
        }

    </div>

    <div class="happy-families-bottom">
        <span>@Localizer["FooterBrand"]</span>
        <span>@Localizer["FooterNote"]</span>
    </div>

</section>

@code {
    private List<HappyFamilyListDto> Families = new();

    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Families = (await HappyFamiliesService.GetAllAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}
