@page "/happy-families"

@using BagheerasDream.Application.Interfaces
@using BagheerasDream.Application.DTOs.HappyFamilies

@inject IHappyFamiliesService HappyFamiliesService

<PageTitle>Happy Families | Bagheera's Dream</PageTitle>

<HeadContent>
    <meta name="description"
          content="Discover the happy families and beautiful moments shared by the kittens from Bagheera's Dream." />

    <link rel="canonical" href="https://bagheerasdream.de/happy-families" />

    <meta property="og:title"
          content="Happy Families | Bagheera's Dream" />

    <meta property="og:description"
          content="A collection of beautiful moments and happy families who welcomed our kittens into their homes." />

    <meta property="og:url"
          content="https://bagheerasdream.de/happy-families" />

    <meta property="og:image"
          content="https://bagheerasdream.de/images/home/5.jpg" />

    <meta property="og:type" content="website" />
</HeadContent>

<section class="happy-families-page">

    <!-- HEADER -->
    <div class="happy-families-header">

        <span class="section-eyebrow">
            A LIFETIME OF LOVE AND HAPPINESS
        </span>

        <h1>
            HAPPY <span>FAMILIES</span>
        </h1>

        <p>
            Nothing makes us happier than seeing our kittens grow up
            surrounded by love. Every kitten that leaves our home
            becomes part of a new family, creating special memories
            and lifelong friendships.

            Here are some beautiful moments shared by the wonderful
            families who welcomed our kittens into their lives.
        </p>

    </div>

    <!-- GALLERY -->
    <div class="happy-families-container">

        @if (IsLoading)
        {
            <div class="empty-families">
                <p>Loading...</p>
            </div>
        }
        else if (Families.Any())
        {
            <div class="happy-families-grid">

                @foreach (var family in Families)
                {
                    <div class="happy-family-image" @key="family.HappyFamilyId">
                        <img src="@family.Image"
                             alt="Happy family with a Bagheera's Dream kitten"
                             loading="lazy" />
                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-families">
                <h3>Beautiful moments are coming soon.</h3>
                <p>Our gallery will be updated with memories from our happy families.</p>
            </div>
        }

    </div>

    <!-- FOOTER DECORATION -->
    <div class="happy-families-bottom">
        <span>BAGHEERA'S DREAM</span>
        <span>HAPPY FAMILIES, HAPPY KITTENS</span>
    </div>

</section>

@code {
    private List<HappyFamilyListDto> Families = new();

    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Families = (await HappyFamiliesService.GetAllAsync()).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}